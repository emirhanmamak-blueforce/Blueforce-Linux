bf_group_vars_path() {
    local p="$BF_REPO/ansible/inventory/group_vars/all.yml"
    [[ -r "$p" ]] && printf '%s\n' "$p"
}

bf_group_vars_value() {
    local key="$1" file
    file="$(bf_group_vars_path)" || return 1
    awk -v k="$key" '
        $0 ~ "^[[:space:]]*" k "[[:space:]]*:" {
            sub(/^[^:]*:/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, "")
            gsub(/^["\x27]|["\x27]$/, ""); gsub(/[[:space:]]*#.*$/, ""); print; exit
        }' "$file"
}

bf_central_readiness() {
    local file placeholders keyfile
    printf '\n'
    tui_section "Central readiness"
    if ! bf_require_inventory; then
        return 1
    fi
    tui_ok "Inventory found: $BF_INVENTORY ($(bf_inventory_count_all) device(s))"

    if file="$(bf_group_vars_path)"; then
        placeholders="$(grep -c 'PLACEHOLDER' "$file" || true)"
        if [[ "${placeholders:-0}" -gt 0 ]]; then
            tui_warn "group_vars/all.yml still contains ${placeholders} PLACEHOLDER value(s):"
            grep -n 'PLACEHOLDER' "$file" | sed 's/^/         /'
            tui_note "Replace them before a production run; the console refuses nothing here on purpose, it reports."
        else
            tui_ok "No PLACEHOLDER left in group_vars/all.yml"
        fi
    else
        tui_warn "ansible/inventory/group_vars/all.yml was not found."
    fi

    keyfile="${HOME}/.ssh/blueforce_id_ed25519"
    if [[ -r "$keyfile" ]]; then
        tui_ok "Admin SSH key present: $keyfile (contents are never read or printed)"
    else
        tui_warn "Admin SSH key not found at $keyfile (docs/06)."
        tui_note "The inventory may point somewhere else: ansible_ssh_private_key_file."
    fi

    if grep -q 'example' "$BF_INVENTORY" 2>/dev/null || [[ "$BF_INVENTORY" == *example* ]]; then
        tui_warn "This looks like an example inventory; do not aim it at real devices."
    fi
    return 0
}

bf_central_endpoints() {
    local key value
    printf '\n'
    tui_section "Configured central endpoints"
    for key in wg_subnet wg_interface wg_hub_endpoint monitoring_endpoint monitoring_job update_repo_url meg_image_tag support_bundle_dir; do
        value="$(bf_group_vars_value "$key" || true)"
        if [[ -n "$value" ]]; then
            tui_kv "$key" "$value"
        fi
    done
    tui_note "Values come from ansible/inventory/group_vars/all.yml; no secret is stored there or printed here."
    return 0
}

bf_central_probe() {
    local endpoint host port resolved
    printf '\n'
    tui_section "Central endpoint probe (read-only)"
    for endpoint in "$(bf_group_vars_value wg_hub_endpoint || true)" "$(bf_group_vars_value monitoring_endpoint || true)" "$(bf_group_vars_value update_repo_url || true)"; do
        [[ -n "$endpoint" ]] || continue
        host="${endpoint#*//}"
        host="${host%%/*}"
        host="${host%%:*}"
        port=""
        if [[ "$endpoint" =~ :([0-9]+)$ ]]; then
            port="${BASH_REMATCH[1]}"
        elif [[ "$endpoint" == http://* ]]; then
            port=80
        elif [[ "$endpoint" == https://* ]]; then
            port=443
        fi
        if [[ -z "$host" ]]; then
            continue
        fi
        if resolved="$(getent hosts "$host" 2>/dev/null | awk 'NR==1{print $1}')" && [[ -n "$resolved" ]]; then
            if [[ -n "$port" ]]; then
                if timeout 3 bash -c "</dev/tcp/$host/$port" 2>/dev/null; then
                    tui_ok "$host:$port reachable (resolves to $resolved)"
                else
                    tui_warn "$host:$port not reachable (resolves to $resolved)"
                fi
            else
                tui_ok "$host resolves to $resolved (no port derived from the value)"
            fi
        else
            tui_warn "$host does not resolve -- expected while the placeholder is unfilled"
        fi
    done
    return 0
}

bf_wave_gate_state() {
    local wave count
    printf '\n'
    tui_section "Wave rollout gate state"
    if ! bf_require_inventory; then
        return 1
    fi
    if ! bf_inventory_cache; then
        tui_error "Inventory could not be parsed: $BF_INVENTORY"
        return 1
    fi
    for wave in "${BF_WAVES[@]}"; do
        if bf_inventory_group_exists "$wave"; then
            count="$(bf_count_lines "$(bf_inventory_hosts_of_group "$wave" || true)")"
            tui_kv "$wave" "$count device(s)"
        else
            tui_kv "$wave" "absent from the inventory"
        fi
    done
    tui_note "Gate rule: a wave may only start after the previous wave passed its health gate and central approval (docs/10)."
    tui_note "Production additionally needs the typed 'production' confirmation in this console and its override flag."
    return 0
}

bf_central_checklist() {
    printf '\n'
    tui_section "Central preparation checklist (informational)"
    tui_msg "   1. WireGuard hub: endpoint, keys and peer allocation for each bf-<dealer> (docs/08)."
    tui_msg "   2. Enrollment token service: one-time, TTL-limited tokens (docs/29)."
    tui_msg "   3. Monitoring: Prometheus/VictoriaMetrics + Grafana, device_id label = BF-<no> (docs/14)."
    tui_msg "   4. Remote access: RustDesk hbbs/hbbr or MeshCentral reachable over WireGuard (docs/07)."
    tui_msg "   5. Package mirror + offline snapshot for field installs (docs/10, docs/27)."
    tui_msg "   6. Ansible inventory with real hostnames and a per-admin SSH key (docs/02, docs/06, docs/09)."
    tui_note "This console verifies 6 and prepares 1-5; it installs no central component."
    return 0
}

