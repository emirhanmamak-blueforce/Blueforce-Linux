#!/usr/bin/env bash
#
# bf-menu -- numbered operator console for the Blueforce fleet.
#
# One entry point for two very different jobs:
#   * category 1 installs THIS device locally, on the machine you are sitting at
#   * categories 2 and 5 drive the fleet through the existing Ansible playbooks
#     with an explicit --limit and never invent a new playbook
#
# Safety rules this console is built around:
#   * every command is printed before it runs and must be confirmed,
#   * destructive operations ask a second, explicit question,
#   * wave-gated playbooks are never handed a gate flag silently: the operator
#     has to confirm the gate (and type "production" for the production wave),
#   * the audit log is mode 600 and never receives a secret: only the sanitized
#     command, its exit status and the target are recorded (raw playbook output
#     is shown on screen but never written to the log),
#   * a missing Ansible, inventory or playbook produces an explanation, never a
#     silent fallback to "something similar".
#
# Usage: admin/bf-menu [options]      (see --help)
#
set -euo pipefail

BF_MENU_VERSION="1.0.0"
BF_MENU_NAME="admin/bf-menu"
DEFAULT_LOG_FILE="/var/log/blueforce-console.log"
INSTALLER_REL="scripts/install/blueforce-install.sh"
PLAYBOOK_DIR_REL="ansible/playbooks"

# ---------------------------------------------------------------------------
# Globals (set by argument parsing / discovery)
# ---------------------------------------------------------------------------
BF_REPO="${BF_REPO:-}"
BF_INVENTORY="${BF_INVENTORY:-}"
BF_LOG_FILE="${BF_CONSOLE_LOG:-$DEFAULT_LOG_FILE}"
BF_LOG_READY=0
BF_DRY_RUN=0
BF_INVENTORY_CACHE_FILE=""
BF_CMD=()
BF_EXTRA=()
BF_LAST_RC=0

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
bf_usage() {
    cat <<EOF
Usage: $BF_MENU_NAME [options]

Numbered operator console for the Blueforce fleet ($BF_MENU_VERSION).

  Category 1 installs THIS device locally with the one-click installer.
  Categories 2 and 5 run the repository's existing Ansible playbooks against
  the fleet, always with an explicit --limit. No new playbook is introduced
  and no device outside the inventory is ever addressed.

Options:
  -h, --help             Show this help and exit
  -V, --version          Show the console version and exit
      --repo PATH        Repository root (default: parent directory of this script)
      --inventory PATH   Ansible inventory (default: \$repo/ansible/inventory/hosts.yml)
      --log-file PATH    Audit log (default: $DEFAULT_LOG_FILE)
      --dry-run          Print every command instead of running it
      --no-color         Disable ANSI colors (also honored: NO_COLOR)
      --list             Print the operation catalogue and exit
      --list-targets     Print inventory groups and host counts, then exit

Environment:
  BF_REPO, BF_INVENTORY, BF_CONSOLE_LOG   same as the options above

Exit status: 0 success or clean quit, 1 failure, 2 usage error.
EOF
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
bf_parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -h|--help) bf_usage; exit 0 ;;
            -V|--version) printf '%s %s\n' "$BF_MENU_NAME" "$BF_MENU_VERSION"; exit 0 ;;
            --repo) [[ $# -ge 2 ]] || { printf 'ERROR: --repo needs a path\n' >&2; exit 2; }; BF_REPO="$2"; shift 2 ;;
            --inventory) [[ $# -ge 2 ]] || { printf 'ERROR: --inventory needs a path\n' >&2; exit 2; }; BF_INVENTORY="$2"; shift 2 ;;
            --log-file) [[ $# -ge 2 ]] || { printf 'ERROR: --log-file needs a path\n' >&2; exit 2; }; BF_LOG_FILE="$2"; shift 2 ;;
            --dry-run) BF_DRY_RUN=1; shift ;;
            --no-color) TUI_COLOR_MODE=never; shift ;;
            --list) BF_LIST=1; shift ;;
            --list-targets) BF_LIST_TARGETS=1; shift ;;
            *) printf 'ERROR: unknown argument: %s\n' "$1" >&2; bf_usage >&2; exit 2 ;;
        esac
    done
}
BF_LIST=0
BF_LIST_TARGETS=0

# ---------------------------------------------------------------------------
# Repository discovery
# ---------------------------------------------------------------------------
bf_resolve_repo() {
    local self self_real self_dir
    if [[ -z "$BF_REPO" ]]; then
        # bf-bootstrap.sh links this script into a bin directory, so the path we
        # were invoked through is usually a symlink: resolve it before deriving
        # the repository root.
        self="${BASH_SOURCE[0]}"
        self_real="$(readlink -f -- "$self" 2>/dev/null || printf '%s' "$self")"
        self_dir="$(cd "$(dirname "$self_real")" && pwd)"
        BF_REPO="$(cd "$self_dir/.." && pwd)"
    fi
    if [[ ! -d "$BF_REPO/ansible" || ! -d "$BF_REPO/scripts" ]]; then
        printf 'ERROR: %s does not look like the Blueforce repository (no ansible/ and scripts/).\n' "$BF_REPO" >&2
        printf '       Clone it and run the console from the checkout, or pass --repo PATH.\n' >&2
        exit 2
    fi
    if [[ ! -r "$BF_REPO/admin/lib/tui.sh" || ! -r "$BF_REPO/admin/lib/targets.sh" ]]; then
        printf 'ERROR: %s/admin/lib/tui.sh or targets.sh is missing.\n' "$BF_REPO" >&2
        printf '       The console needs its libraries next to it (admin/lib/).\n' >&2
        exit 2
    fi
    export BF_REPO
}

# ---------------------------------------------------------------------------
# Audit log: mode 600, sanitized, never a secret
# ---------------------------------------------------------------------------
# bf_log_sanitize -- single choke point before anything reaches the log file.
bf_log_sanitize() {
    sed -E \
        -e 's/((password|passwd|passphrase|secret|token|api[_-]?key|private[_-]?key|preshared[_-]?key|psk|credential)[A-Za-z0-9_.-]*[[:space:]]*[=:])[^[:space:]]+/\1<redacted>/Ig' \
        -e 's/(BEGIN [A-Z ]*PRIVATE KEY).*/\1 <redacted>/g'
}

bf_log() {
    local level="$1"; shift
    [[ "$BF_LOG_READY" -eq 1 ]] || return 0
    printf '%s [%s] %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$level" "$(printf '%s' "$*" | bf_log_sanitize)" >>"$BF_LOG_FILE"
}

# bf_log_init -- keep the log at mode 600 or refuse to log into an insecure
# path. Falls back to a per-user state directory when /var/log is not writable.
bf_log_init() {
    local fallback_dir candidate
    fallback_dir="${XDG_STATE_HOME:-$HOME/.local/state}/blueforce"
    for candidate in "$BF_LOG_FILE" "$fallback_dir/blueforce-console.log"; do
        [[ -n "$candidate" ]] || continue
        if [[ -e "$candidate" ]]; then
            [[ -w "$candidate" ]] || continue
        else
            mkdir -p "$(dirname "$candidate")" 2>/dev/null || continue
            [[ -w "$(dirname "$candidate")" ]] || continue
        fi
        if [[ -e "$candidate" ]]; then
            chmod 600 "$candidate" 2>/dev/null || continue
        else
            ( umask 077; : >"$candidate" ) 2>/dev/null || continue
            chmod 600 "$candidate" 2>/dev/null || continue
        fi
        BF_LOG_FILE="$candidate"
        BF_LOG_READY=1
        if [[ "$candidate" != "${BF_LOG_REQUESTED:-$DEFAULT_LOG_FILE}" ]]; then
            printf '[WARN] %s is not writable; logging to %s instead (mode 600).\n' \
                "${BF_LOG_REQUESTED:-$DEFAULT_LOG_FILE}" "$candidate" >&2
        fi
        return 0
    done
    BF_LOG_READY=0
    printf '[WARN] no writable audit log found; this session will not be logged.\n' >&2
    return 0
}

bf_cleanup() {
    if [[ -n "$BF_INVENTORY_CACHE_FILE" && -f "$BF_INVENTORY_CACHE_FILE" ]]; then
        rm -f "$BF_INVENTORY_CACHE_FILE"
    fi
}

bf_quit() {
    local code="${1:-0}"
    tui_note "Leaving the Blueforce console."
    exit "$code"
}

# ---------------------------------------------------------------------------
# Runtime checks with explanations instead of guesses
# ---------------------------------------------------------------------------
bf_have_ansible() {
    command -v ansible-playbook >/dev/null 2>&1
}

bf_require_ansible() {
    if bf_have_ansible; then
        return 0
    fi
    tui_error "ansible-playbook was not found on this machine; fleet operations cannot run."
    tui_note  "The console does not emulate Ansible: it drives the repository's playbooks (docs/09)."
    tui_note  "Install it on the admin machine, e.g.:"
    tui_note  "  sudo apt install ansible        # or: pipx install ansible-core"
    return 1
}

bf_require_inventory() {
    local resolved
    # stdout carries the resolved path, stderr carries the explanation: never
    # merge them, or an error message would end up inside the path.
    if resolved="$(bf_inventory_resolve)"; then
        BF_INVENTORY="$resolved"
        export BF_INVENTORY
        return 0
    fi
    return 1
}

bf_require_root() {
    if [[ "$(id -u)" -eq 0 ]]; then
        return 0
    fi
    tui_error "This operation needs root on THIS device."
    tui_note  "Re-run the console with sudo:  sudo $BF_MENU_NAME"
    return 1
}

# bf_tool_path NAME -> preferred path of a diagnostics/maintenance tool.
# A tool installed under /usr/local/bin wins (that is the canonical Field OS
# location); otherwise the copy in this checkout is used.
bf_tool_path() {
    local name="$1"
    local sys="/usr/local/bin/$name"
    local repo="$BF_REPO/scripts/diagnostics/$name"
    local maint="$BF_REPO/scripts/maintenance/$name"
    if [[ -x "$sys" ]]; then printf '%s\n' "$sys"; return 0; fi
    if [[ -x "$repo" ]]; then printf '%s\n' "$repo"; return 0; fi
    if [[ -x "$maint" ]]; then printf '%s\n' "$maint"; return 0; fi
    return 1
}

bf_installer_path() {
    local p="$BF_REPO/$INSTALLER_REL"
    [[ -f "$p" ]] && printf '%s\n' "$p"
}

# ---------------------------------------------------------------------------
# Execution
# ---------------------------------------------------------------------------
# bf_cmd_string -- the command as a copy/pasteable shell line.
bf_cmd_string() {
    printf '%q ' "${BF_CMD[@]}"
}

# bf_exec -- run BF_CMD (or print it under --dry-run). Sets BF_LAST_RC.
bf_exec() {
    local printable rc=0
    printable="$(bf_cmd_string)"
    printf '\n'
    tui_section "Command"
    printf '   %s\n\n' "$printable"
    if [[ "$BF_DRY_RUN" -eq 1 ]]; then
        tui_warn "dry-run: the command above was NOT executed."
        bf_log "DRYRUN" "$printable"
        BF_LAST_RC=0
        return 0
    fi
    bf_log "RUN" "$printable"
    set +e
    "${BF_CMD[@]}"
    rc=$?
    set -e
    BF_LAST_RC="$rc"
    if [[ "$rc" -eq 0 ]]; then
        tui_ok "Command finished successfully (exit 0)."
        bf_log "OK" "exit=0 :: $printable"
    else
        tui_error "Command failed with exit $rc."
        bf_log "FAIL" "exit=$rc :: $printable"
    fi
    return 0
}

# bf_confirm_and_exec LABEL DESTRUCTIVE
# Shows the command, asks for confirmation, then runs it. Returns 0 when the
# command was executed (including a confirmed --check run), 1 when cancelled.
bf_confirm_and_exec() {
    local label="$1" destructive="${2:-no}" answer=0
    if [[ "$BF_DRY_RUN" -eq 1 ]]; then
        bf_exec
        return 0
    fi
    if [[ "$destructive" == "yes" ]]; then
        tui_warn "State-changing operation: $label"
        tui_warn "Read the command above before confirming; it changes the selected target(s)."
        tui_ask_run "Proceed? " || answer=$?
    else
        tui_ask_run "Run this command?" || answer=$?
    fi
    case "$answer" in
        0) : ;;
        2)
            BF_CMD+=(--check)
            tui_info "check mode: the command runs with --check and applies no change."
            ;;
        *)
            tui_info "Cancelled; nothing was run."
            bf_log "CANCEL" "aborted by operator :: $(bf_cmd_string)"
            return 1
            ;;
    esac
    bf_exec
    return 0
}

# ---------------------------------------------------------------------------
# Operation catalogue
# ---------------------------------------------------------------------------
# Fields: id|label|playbook|scope|destructive|prompt|description
#   scope       simple | wave | release   (cross-checked against the playbook)
#   destructive yes|no                    (second confirmation)
#   prompt      none | packages | service | script | grace | disk_pct |
#               log_lines | expected_version
BF_OPS_REPORT=(
    "ping|Ping / reachability|bf-ping.yml|simple|no|none|SSH reachability check (read-only)"
    "uptime|Uptime|bf-uptime.yml|simple|no|none|Uptime and load (read-only)"
    "disk|Disk usage|bf-disk-check.yml|simple|no|disk_pct|Disk usage, warns above a threshold"
    "docker|Docker status|bf-docker-status.yml|simple|no|none|Docker daemon and containers (read-only)"
    "packages|Package versions|bf-package-check.yml|simple|no|none|Installed versions of pinned packages"
    "security-updates|Pending security updates|bf-security-updates-check.yml|simple|no|none|Report only, never installs"
    "provisioning-status|Provisioning phase report|bf-provisioning-status.yml|wave|no|none|state.json phase per device"
    "enrollment-status|Enrollment + central evidence|bf-enrollment-status.yml|wave|no|none|ENROLLED/READY claims vs central proof"
    "fieldos-version|Field OS version report|bf-fieldos-version.yml|wave|no|expected_version|Version per device, optional drift check"
    "remote-channels|Remote access channels|bf-remote-channels-check.yml|wave|no|none|SSH/xRDP/RustDesk/WireGuard readiness"
    "offline-ready|Offline readiness report|bf-offline-ready-check.yml|wave|no|none|Local preconditions for offline provisioning"
)

BF_OPS_MAINTENANCE=(
    "rdp-restart|Restart RDP|bf-rdp-restart.yml|simple|yes|none|Restart xrdp"
    "rustdesk-restart|Restart RustDesk|bf-rustdesk-restart.yml|simple|yes|none|Restart the RustDesk service"
    "wireguard-restart|Restart WireGuard|bf-wireguard-restart.yml|simple|yes|none|Restart wg-quick@wg0"
    "service-restart|Restart an allowlisted service|bf-service-restart.yml|simple|yes|service|Allowlisted service names only"
    "gui-off|GUI off (headless)|bf-gui-off.yml|wave|yes|none|Switch the wave to multi-user.target"
    "gui-on|GUI on (maintenance)|bf-gui-on.yml|wave|yes|none|Start the graphical session again"
    "collect-logs|Collect logs / support bundle|bf-collect-logs.yml|wave|no|log_lines|Timestamped journal + snapshot bundle"
    "run-script|Run an approved script|bf-run-script.yml|wave|yes|script|Only /opt/blueforce/bin and /usr/local/sbin"
    "reboot|Controlled reboot|bf-reboot.yml|release|yes|grace|Serial reboots with a health gate"
    "deploy-update|Deploy approved package update|bf-deploy-update.yml|release|yes|packages|Pinned package=version, health-gated"
)

bf_op_field() {
    local row="$1" field="$2"
    printf '%s' "$row" | awk -F'|' -v n="$field" '{print $n}'
}

# ---------------------------------------------------------------------------
# Playbook helpers: the playbook file stays the source of truth for its gates
# ---------------------------------------------------------------------------
# bf_playbook_var_present PLAYBOOK VAR -- true when VAR is used outside comments.
bf_playbook_var_present() {
    local pb="$1" var="$2" file="$BF_REPO/$PLAYBOOK_DIR_REL/$1"
    [[ -r "$file" ]] || return 1
    grep -vE '^[[:space:]]*#' "$file" | grep -qE "\\b${var}\\b"
}

# bf_playbook_scope PLAYBOOK -> wave|release|simple, derived from the playbook.
bf_playbook_scope() {
    local pb="$1"
    if bf_playbook_var_present "$pb" release_wave; then
        printf 'release\n'
        return 0
    fi
    if bf_playbook_var_present "$pb" operation_wave; then
        printf 'wave\n'
        return 0
    fi
    printf 'simple\n'
}

# bf_playbook_check PLAYBOOK DECLARED_SCOPE -- existence plus a metadata
# cross-check, so a console table that drifted from the playbook can never
# silently drop a wave gate.
bf_playbook_check() {
    local pb="$1" declared="$2" file="$BF_REPO/$PLAYBOOK_DIR_REL/$1" actual
    if [[ ! -r "$file" ]]; then
        tui_error "Playbook not found: ansible/playbooks/$pb"
        tui_note  "Expected at: $file"
        tui_note  "Set --repo to the repository checkout that contains it."
        return 1
    fi
    actual="$(bf_playbook_scope "$pb")"
    if [[ "$actual" != "$declared" ]]; then
        tui_error "Refusing to run $pb: the console expects scope '$declared' but the playbook declares '$actual'."
        tui_note  "The playbook is the source of truth for its gates; update admin/bf-menu before using it."
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Extra -e variables, validated with the same rules the playbooks enforce
# ---------------------------------------------------------------------------
BF_SERVICE_ALLOWLIST=(blueforce-agent docker ssh sshd systemd-journald cron)
BF_SCRIPT_DIRS=(/opt/blueforce/bin /usr/local/sbin)

bf_prompt_extra() {
    local kind="$1"
    BF_EXTRA=()
    case "$kind" in
        none) return 0 ;;
        packages) bf_prompt_packages ;;
        service) bf_prompt_service ;;
        script) bf_prompt_script ;;
        grace) bf_prompt_grace ;;
        disk_pct) bf_prompt_disk_pct ;;
        log_lines) bf_prompt_log_lines ;;
        expected_version) bf_prompt_expected_version ;;
        *) tui_error "Console bug: unknown prompt kind '$kind'."; return 1 ;;
    esac
}

bf_prompt_packages() {
    local pins=() pin array=()
    tui_note "Exact pins only: package=version (the playbook refuses ranges, 'latest' and empty lists)."
    tui_prompt "Packages (comma separated)" "" || return 1
    if [[ -z "$TUI_REPLY" ]]; then
        tui_error "At least one pinned package is required."
        return 1
    fi
    IFS=',' read -r -a pins <<<"$TUI_REPLY"
    for pin in "${pins[@]}"; do
        pin="${pin#"${pin%%[![:space:]]*}"}"
        pin="${pin%"${pin##*[![:space:]]}"}"
        [[ -n "$pin" ]] || continue
        if [[ ! "$pin" =~ ^[A-Za-z0-9][A-Za-z0-9+_.:-]*=.+$ ]]; then
            tui_error "Invalid pin '$pin': expected package=version (e.g. docker-ce=5:27.0.3-1~ubuntu.24.04~noble)."
            return 1
        fi
        array+=("\"$pin\"")
    done
    [[ ${#array[@]} -gt 0 ]] || { tui_error "No usable package pin was given."; return 1; }
    BF_EXTRA=(-e "update_packages=[$(IFS=,; printf '%s' "${array[*]}")]")
    return 0
}

bf_prompt_service() {
    local name
    tui_note "Allowlist: ${BF_SERVICE_ALLOWLIST[*]}"
    tui_prompt "Service name" "" || return 1
    name="$TUI_REPLY"
    for allowed in "${BF_SERVICE_ALLOWLIST[@]}"; do
        if [[ "$name" == "$allowed" ]]; then
            BF_EXTRA=(-e "service_name=$name")
            return 0
        fi
    done
    tui_error "Refusing '$name': not in the service allowlist (the playbook would fail closed anyway)."
    return 1
}

bf_prompt_script() {
    local path args dir ok=0
    tui_note "Allowed directories: ${BF_SCRIPT_DIRS[*]}"
    tui_prompt "Script path" "" || return 1
    path="$TUI_REPLY"
    if [[ "$path" != /* ]]; then
        tui_error "Script path must be absolute."
        return 1
    fi
    for dir in "${BF_SCRIPT_DIRS[@]}"; do
        [[ "$path" == "$dir"/* ]] && ok=1
    done
    if [[ "$ok" -ne 1 ]]; then
        tui_error "Refusing '$path': outside the approved directories (the playbook would refuse it too)."
        return 1
    fi
    tui_prompt "Script arguments (optional)" "" || return 1
    args="$TUI_REPLY"
    BF_EXTRA=(-e "script_path=$path")
    if [[ -n "$args" ]]; then
        BF_EXTRA+=(-e "script_args=$args")
    fi
    return 0
}

bf_prompt_grace() {
    local seconds
    tui_prompt "Reboot grace period in seconds" "300" || return 1
    seconds="$TUI_REPLY"
    if [[ ! "$seconds" =~ ^[0-9]+$ || "$seconds" -lt 0 ]]; then
        tui_error "Grace period must be a whole number of seconds."
        return 1
    fi
    BF_EXTRA=(-e "reboot_grace_seconds=$seconds")
    return 0
}

bf_prompt_disk_pct() {
    local pct
    tui_prompt "Warn above percent (blank = playbook default 80)" "" || return 1
    pct="$TUI_REPLY"
    if [[ -z "$pct" ]]; then
        return 0
    fi
    if [[ ! "$pct" =~ ^[0-9]+$ || "$pct" -lt 1 || "$pct" -gt 100 ]]; then
        tui_error "Threshold must be between 1 and 100."
        return 1
    fi
    BF_EXTRA=(-e "disk_warn_pct=$pct")
    return 0
}

bf_prompt_log_lines() {
    local lines
    tui_prompt "Journal lines per device" "500" || return 1
    lines="$TUI_REPLY"
    if [[ ! "$lines" =~ ^[0-9]+$ || "$lines" -lt 1 ]]; then
        tui_error "Line count must be a positive whole number."
        return 1
    fi
    BF_EXTRA=(-e "log_lines=$lines")
    return 0
}

bf_prompt_expected_version() {
    local version
    tui_prompt "Expected Field OS version (blank = no drift check)" "" || return 1
    version="$TUI_REPLY"
    if [[ -z "$version" ]]; then
        return 0
    fi
    BF_EXTRA=(-e "fieldos_expected_version=$version")
    return 0
}

# ---------------------------------------------------------------------------
# Ansible command construction
# ---------------------------------------------------------------------------
bf_build_ansible_cmd() {
    local pb="$1" scope="$2" wave="${3:-}" gate_confirmed="${4:-no}"
    # Single choke point: no playbook command is ever built without a target.
    if ! bf_target_is_set; then
        return 1
    fi
    BF_CMD=(ansible-playbook -i "$BF_INVENTORY" "$BF_REPO/$PLAYBOOK_DIR_REL/$pb" --limit "$BF_TARGET_LIMIT")
    case "$scope" in
        wave)
            BF_CMD+=(-e "operation_wave=$wave" -e operation_confirmed=true)
            if [[ "$wave" == "production" ]]; then
                if bf_playbook_var_present "$pb" production_override; then
                    BF_CMD+=(-e production_override=true)
                fi
            fi
            ;;
        release)
            BF_CMD+=(-e "release_wave=$wave")
            if [[ "$gate_confirmed" == "yes" ]] && bf_playbook_var_present "$pb" wave_gate_confirmed; then
                BF_CMD+=(-e wave_gate_confirmed=true)
            fi
            if bf_playbook_var_present "$pb" reboot_confirmed; then
                BF_CMD+=(-e reboot_confirmed=true)
            fi
            if [[ "$wave" == "production" ]]; then
                if bf_playbook_var_present "$pb" production_override; then
                    BF_CMD+=(-e production_override=true)
                fi
                if bf_playbook_var_present "$pb" allow_production_reboot; then
                    BF_CMD+=(-e allow_production_reboot=true)
                fi
            fi
            ;;
    esac
    if [[ ${#BF_EXTRA[@]} -gt 0 ]]; then
        BF_CMD+=("${BF_EXTRA[@]}")
    fi
    return 0
}

# bf_confirm_wave_gate WAVE PLAYBOOK -- reproduce the playbook's own gate
# contract as an explicit operator statement. Nothing is auto-confirmed.
bf_confirm_wave_gate() {
    local wave="$1" pb="$2"
    if [[ "$wave" != "production" ]]; then
        return 0
    fi
    tui_warn "Wave 'production' is the live fleet: $pb refuses to run without an explicit production override."
    if ! tui_confirm_token "Type production to confirm a PRODUCTION run." "production"; then
        tui_info "Production confirmation not given."
        return 1
    fi
    return 0
}

bf_confirm_release_gate() {
    local pb="$1"
    if ! bf_playbook_var_present "$pb" wave_gate_confirmed; then
        return 0
    fi
    tui_warn "$pb refuses to run unless the wave gate is confirmed."
    tui_warn "Confirm only after the previous wave's health gate and the central approval have passed (docs/10)."
    if ! tui_confirm_token "Wave gate confirmation." "GATE"; then
        tui_info "Wave gate not confirmed."
        return 1
    fi
    return 0
}

# ---------------------------------------------------------------------------
# The device-operation runner
# ---------------------------------------------------------------------------
# bf_show_operation_header ROW -- always show what is about to happen.
bf_show_operation_header() {
    local row="$1"
    tui_kv "Operation" "$(bf_op_field "$row" 2)"
    tui_kv "Playbook" "ansible/playbooks/$(bf_op_field "$row" 3)"
    tui_kv "Scope" "$(bf_op_field "$row" 4)"
    tui_kv "Inventory" "${BF_INVENTORY:-unresolved}"
    tui_kv "Target" "${BF_TARGET_LABEL:-unset}"
    if [[ -n "${BF_TARGET_WAVE:-}" ]]; then
        tui_kv "Wave" "$BF_TARGET_WAVE"
    fi
    printf '\n'
}

# bf_run_wave_once ROW WAVE -- build, confirm and run one wave.
bf_run_wave_once() {
    local row="$1" wave="$2" pb="$3" destructive="$4" gate="no" scope
    scope="$(bf_op_field "$row" 4)"
    # The production token only applies where the playbook actually carries a
    # wave/release gate; a simple playbook on a production device does not.
    if [[ "$scope" != "simple" ]] && ! bf_confirm_wave_gate "$wave" "$pb"; then
        return 1
    fi
    if ! bf_confirm_release_gate "$pb"; then
        return 1
    fi
    if bf_playbook_var_present "$pb" wave_gate_confirmed; then
        gate="yes"
    fi
    if ! bf_build_ansible_cmd "$pb" "$(bf_op_field "$row" 4)" "$wave" "$gate"; then
        tui_error "No target is selected; refusing to build a command."
        return 1
    fi
    printf '\n'
    tui_section "Command"
    printf '   %s\n\n' "$(bf_cmd_string)"
    # Fleet-wide scope is the one selection that can hurt many devices at once:
    # it needs its own explicit confirmation, not just the run prompt.
    if [[ "${BF_TARGET_KIND:-}" == "all" ]]; then
        tui_warn "FLEET-WIDE: this command targets every device in the inventory (${BF_TARGET_COUNT} device(s))."
        if ! tui_confirm_token "Fleet-wide scope confirmation." "all"; then
            tui_info "Fleet-wide confirmation not given."
            bf_log "CANCEL" "fleet-wide confirmation withheld :: $(bf_cmd_string)"
            return 1
        fi
    fi
    bf_confirm_and_exec "$(bf_op_field "$row" 2) on wave '$wave'" "$destructive" || return 1
    return 0
}

# bf_run_row ROW -- full flow: target selection, extra vars, execution.
bf_run_row() {
    local row="$1" id pb declared scope prompt destructive mode wave count
    id="$(bf_op_field "$row" 1)"
    pb="$(bf_op_field "$row" 3)"
    declared="$(bf_op_field "$row" 4)"
    destructive="$(bf_op_field "$row" 5)"
    prompt="$(bf_op_field "$row" 6)"

    bf_require_ansible || return 1
    bf_require_inventory || return 1
    bf_playbook_check "$pb" "$declared" || return 1
    scope="$declared"

    case "$scope" in
        wave) mode="wave" ;;
        release) mode="release" ;;
        *) mode="any" ;;
    esac

    tui_screen "$(bf_op_field "$row" 2)" "$(bf_op_field "$row" 7)"
    tui_note "Choose the target: dealer number, group, or all."
    if [[ "$scope" == "release" ]]; then
        tui_note "Release-gated playbooks accept one approved wave, never a single device."
    fi
    printf '\n'
    if ! bf_target_select "$mode"; then
        return 0
    fi

    if ! bf_prompt_extra "$prompt"; then
        tui_warn "No command was built."
        tui_pause
        return 0
    fi
    bf_log "TARGET" "$id target=${BF_TARGET_LIMIT} kind=${BF_TARGET_KIND} wave=${BF_TARGET_WAVE:-none}"

    if [[ "$scope" == "wave" && "$BF_TARGET_KIND" == "all" ]]; then
        tui_screen "$(bf_op_field "$row" 2)" "wave by wave, stops at the first failure"
        tui_warn "This playbook is wave-scoped: the fleet is processed one wave at a time."
        tui_warn "Order: $(bf_waves_csv | tr ',' ' '). Each wave is shown and confirmed separately."
        printf '\n'
        if ! tui_confirm "Start with the first wave?"; then
            tui_info "Cancelled; nothing was run."
            return 0
        fi
        # An array, not `while read < <(...)`: a redirection on a loop would also
        # hijack the stdin that the confirmation prompts read from.
        local waves=()
        mapfile -t waves < <(bf_wave_groups_present || true)
        for wave in "${waves[@]}"; do
            [[ -n "$wave" ]] || continue
            count="$(bf_count_lines "$(bf_inventory_hosts_of_group "$wave" || true)")"
            tui_screen "$(bf_op_field "$row" 2)" "wave $wave -- $count device(s)"
            if ! tui_confirm_token "About to run on wave '$wave' ($count device(s))." "$wave"; then
                tui_info "Wave '$wave' skipped by the operator."
                tui_pause
                continue
            fi
            BF_TARGET_KIND="group"
            BF_TARGET_LIMIT="$wave"
            BF_TARGET_WAVE="$wave"
            BF_TARGET_COUNT="$count"
            BF_TARGET_LABEL="wave '$wave' ($count device(s))"
            if ! bf_run_wave_once "$row" "$wave" "$pb" "$destructive"; then
                tui_error "Wave '$wave' did not run to completion; stopping the sequence (no later wave is touched)."
                bf_log "STOP" "$id stopped after wave=$wave"
                tui_pause
                return 1
            fi
            if [[ "$BF_LAST_RC" -ne 0 ]]; then
                tui_error "Wave '$wave' failed (exit $BF_LAST_RC); stopping the sequence."
                bf_log "STOP" "$id failed at wave=$wave"
                tui_pause
                return 1
            fi
            tui_pause
        done
        return 0
    fi

    wave="${BF_TARGET_WAVE:-}"
    if [[ "$scope" == "wave" && -z "$wave" ]]; then
        tui_error "This playbook is wave-scoped but the target carries no approved wave."
        tui_note  "Pick a wave group (or a device that belongs to one)."
        tui_pause
        return 1
    fi
    if [[ "$scope" == "release" && -z "$wave" ]]; then
        tui_error "Release-gated playbooks need an approved wave group as the target."
        tui_pause
        return 1
    fi

    tui_screen "$(bf_op_field "$row" 2)" "$(bf_op_field "$row" 7)"
    bf_show_operation_header "$row"
    bf_run_wave_once "$row" "$wave" "$pb" "$destructive" || return 0
    tui_pause
    return 0
}

# ---------------------------------------------------------------------------
# Local (on this device) command runner
# ---------------------------------------------------------------------------
# bf_local LABEL DESTRUCTIVE -- cmd... : show, confirm, run a local command.
bf_local() {
    local label="$1" destructive="$2"
    shift 2
    BF_CMD=("$@")
    printf '\n'
    tui_section "$label"
    bf_confirm_and_exec "$label" "$destructive" || return 1
    return 0
}

# bf_show_local_cmd LABEL -- cmd... : run a read-only command without ceremony.
# The command is passed as arguments; when it is omitted, the caller's BF_CMD is
# used as-is (defensive: an accidental empty argument list must not erase it).
bf_show_local_cmd() {
    local label="$1"
    shift
    if [[ $# -gt 0 ]]; then
        BF_CMD=("$@")
    fi
    printf '\n'
    tui_section "$label"
    printf '   %s\n\n' "$(bf_cmd_string)"
    if [[ "$BF_DRY_RUN" -eq 1 ]]; then
        tui_warn "dry-run: the command above was NOT executed."
        return 0
    fi
    bf_log "RUN" "$(bf_cmd_string)"
    set +e
    "${BF_CMD[@]}"
    BF_LAST_RC=$?
    set -e
    if [[ "$BF_LAST_RC" -eq 0 ]]; then
        bf_log "OK" "exit=0 :: $(bf_cmd_string)"
    else
        tui_warn "Command exited with $BF_LAST_RC."
        bf_log "FAIL" "exit=$BF_LAST_RC :: $(bf_cmd_string)"
    fi
    return 0
}

# bf_run_tool NAME [ARGS...] -- run a diagnostics tool from the preferred path.
bf_run_tool() {
    local name="$1"
    shift
    local path
    if ! path="$(bf_tool_path "$name")"; then
        tui_warn "$name is not available (neither /usr/local/bin/$name nor the checkout copy)."
        tui_note "Install it from this checkout: sudo install -m 0755 scripts/diagnostics/$name /usr/local/bin/$name"
        return 1
    fi
    bf_show_local_cmd "$name" "$path" "$@"
    return 0
}

