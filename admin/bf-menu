            7)
                if ! bf_run_tool bf-diagnostics; then
                    bf_run_tool bf-status || true
                fi
                tui_pause
                ;;
            8) bf_run_tool bf-live-hw-check; tui_pause ;;
            9) bf_run_tool bf-remote-status --check; tui_pause ;;
            10) bf_run_tool bf-release; tui_pause ;;
            11)
                if [[ "$(id -u)" -eq 0 ]]; then
                    out_dir="/var/lib/blueforce/inventory"
                else
                    out_dir="${XDG_STATE_HOME:-$HOME/.local/state}/blueforce/inventory"
                fi
                if bf_tool_path bf-hardware-inventory.sh >/dev/null 2>&1; then
                    tui_prompt "Dealer number (8 digits)" "" || continue
                    if ! bf_dealer_validate "$TUI_REPLY"; then
                        tui_error "Invalid dealer number; it must match ${BF_DEALER_RE}."
                        tui_pause; continue
                    fi
                    bf_show_local_cmd "Hardware inventory for $(bf_dealer_to_device_id "$TUI_REPLY")" \
                        "$(bf_tool_path bf-hardware-inventory.sh)" --dealer-id "$TUI_REPLY" --out-dir "$out_dir"
                else
                    tui_warn "bf-hardware-inventory.sh is not available."
                fi
                tui_pause
                ;;
            12)
                if bf_tool_path bf-support-bundle >/dev/null 2>&1; then
                    bf_local "Support bundle" "no" "$(bf_tool_path bf-support-bundle)" --out-dir /var/tmp
                else
                    tui_warn "bf-support-bundle is not available."
                fi
                tui_pause
                ;;
            13)
                BF_CMD=(tail -n 40 "$BF_LOG_FILE")
                bf_show_local_cmd "Console log ($BF_LOG_FILE)" "${BF_CMD[@]}"
                tui_pause
                ;;
            *) tui_error "Unknown choice '$choice'."; tui_pause ;;
        esac
    done
}

bf_show_environment() {
    printf '\n'
    tui_section "Environment"
    tui_kv "Console" "$BF_MENU_NAME $BF_MENU_VERSION"
    tui_kv "Repository" "$BF_REPO"
    tui_kv "Inventory" "${BF_INVENTORY:-not resolved yet}"
    tui_kv "Audit log" "$BF_LOG_FILE (mode $(stat -c '%a' "$BF_LOG_FILE" 2>/dev/null || echo '?'))"
    tui_kv "dry-run" "$([[ "$BF_DRY_RUN" -eq 1 ]] && echo yes || echo no)"
    tui_kv "Running as" "uid $(id -u) ($(id -un 2>/dev/null || echo unknown))"
    tui_kv "Ansible" "$(command -v ansible-playbook 2>/dev/null || echo 'not installed')"
    if bf_have_ansible; then
        tui_kv "ansible-core" "$(ansible --version 2>/dev/null | awk 'NR==1{print $2}' || echo unknown)"
    fi
    tui_kv "Installer" "$(bf_installer_path || echo 'not found')"
    tui_kv "Playbook dir" "$BF_REPO/$PLAYBOOK_DIR_REL"
    printf '\n'
    tui_section "Resolved tool paths"
    for tool in bf-status bf-diagnostics bf-check-local bf-check-enrollment bf-check-ready bf-release bf-remote-status bf-support-bundle bf-hardware-inventory.sh; do
        tui_kv "$tool" "$(bf_tool_path "$tool" || echo 'not available')"
    done
    return 0
}

bf_print_catalogue() {
    local row index
    printf '\n'
    tui_section "Category 2.1 -- read-only fleet reports"
    index=0
    for row in "${BF_OPS_REPORT[@]}"; do
        index=$((index + 1))
        printf '   %2s) %-34s %-36s scope=%-8s destructive=%s\n' "$index" "$(bf_op_field "$row" 1)" \
            "$(bf_op_field "$row" 3)" "$(bf_op_field "$row" 4)" "$(bf_op_field "$row" 5)"
    done
    printf '\n'
    tui_section "Category 2.2 -- fleet maintenance"
    index=0
    for row in "${BF_OPS_MAINTENANCE[@]}"; do
        index=$((index + 1))
        printf '   %2s) %-34s %-36s scope=%-8s destructive=%s\n' "$index" "$(bf_op_field "$row" 1)" \
            "$(bf_op_field "$row" 3)" "$(bf_op_field "$row" 4)" "$(bf_op_field "$row" 5)"
    done
    printf '\n'
    tui_note "scope=wave needs -e operation_wave=<wave> -e operation_confirmed=true (set by this console after confirmation)."
    tui_note "scope=release needs -e release_wave=<wave> plus the wave gate typed confirmation."
    return 0
}

