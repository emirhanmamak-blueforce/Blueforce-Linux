bf_installer_or_error() {
    local path
    if ! path="$(bf_installer_path)"; then
        tui_error "Installer not found: $INSTALLER_REL"
        tui_note  "Set --repo to the checkout that contains it, or clone the repository first:"
        tui_note  "  git clone <repository-url> Blueforce-Linux && cd Blueforce-Linux"
        return 1
    fi
    printf '%s\n' "$path"
}

bf_cat_install() {
    local installer choice dealer offline=0 resume=0
    while true; do
        tui_screen "1) Installation (this device)" "Local install only -- no fleet device is touched here"
        tui_item 1 "Pre-flight check" "installer --check, writes nothing"
        tui_item 2 "Install this device" "full run, asks dealer number"
        tui_item 3 "Resume after a failed run" "installer --resume"
        tui_item 4 "Run a single module" "installer --only"
        tui_item 5 "Show module state" "/var/lib/blueforce/install-state"
        tui_item 6 "Show the installer log" "tail of /var/log/blueforce-install.log"
        tui_footer
        if ! tui_read "Choice > "; then bf_quit; fi
        choice="$TUI_REPLY"
        case "$choice" in
            0) return 0 ;;
            q|Q) bf_quit ;;
            1)
                installer="$(bf_installer_or_error)" || { tui_pause; continue; }
                tui_note "Read-only pre-flight: the installer creates no log, state or directory in --check mode."
                tui_read "Dealer number (8 digits) > " || bf_quit
                dealer="$TUI_REPLY"
                if ! bf_dealer_validate "$dealer"; then
                    tui_error "Invalid dealer number '$dealer': it must match ${BF_DEALER_RE}."
                    tui_pause; continue
                fi
                BF_CMD=(bash "$installer" --dealer-id "$dealer" --check)
                bf_show_local_cmd "Pre-flight check for $(bf_dealer_to_device_id "$dealer")" "${BF_CMD[@]}"
                tui_pause
                ;;
            2|3|4)
                installer="$(bf_installer_or_error)" || { tui_pause; continue; }
                bf_require_root || { tui_pause; continue; }
                printf '\n'
                tui_read "Dealer number (8 digits) > " || bf_quit
                dealer="$TUI_REPLY"
                if ! bf_dealer_validate "$dealer"; then
                    tui_error "Invalid dealer number '$dealer': it must match ${BF_DEALER_RE}."
                    tui_pause; continue
                fi
                offline=0 resume=0
                if [[ "$choice" == "3" ]]; then
                    resume=1
                else
                    if tui_confirm "Install from the local offline repository (--offline)?"; then
                        offline=1
                    fi
                    if [[ "$choice" == "2" ]] && tui_confirm "Resume: skip modules already recorded as OK?"; then
                        resume=1
                    fi
                fi
                BF_CMD=(bash "$installer" --dealer-id "$dealer")
                [[ "$offline" -eq 1 ]] && BF_CMD+=(--offline)
                [[ "$resume" -eq 1 ]] && BF_CMD+=(--resume)
                if [[ "$choice" == "4" ]]; then
                    bf_pick_module "$installer" || { tui_pause; continue; }
                fi
                printf '\n'
                tui_info "Target device: $(bf_dealer_to_device_id "$dealer") ($(bf_dealer_to_host "$dealer"))"
                bf_confirm_and_exec "install on $(bf_dealer_to_device_id "$dealer")" "yes" || true
                tui_pause
                ;;
            5)
                BF_CMD=(cat /var/lib/blueforce/install-state)
                bf_show_local_cmd "Installer module state" "${BF_CMD[@]}"
                tui_pause
                ;;
            6)
                BF_CMD=(tail -n 40 /var/log/blueforce-install.log)
                bf_show_local_cmd "Installer log (last 40 lines)" "${BF_CMD[@]}"
                tui_pause
                ;;
            *) tui_error "Unknown choice '$choice'."; tui_pause ;;
        esac
    done
}

# bf_pick_module INSTALLER -- choose one installer module and append --only.
bf_pick_module() {
    local installer="$1" dir index=0 name choice i=0 pick="" modules=()
    dir="$BF_REPO/scripts/install/installer/modules"
    if [[ ! -d "$dir" ]]; then
        tui_error "Module directory not found: $dir"
        return 1
    fi
    while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        modules+=("$name")
    done < <(find "$dir" -maxdepth 1 -type f -name '[0-9][0-9]-*.sh' -printf '%f\n' 2>/dev/null | sort)
    if [[ ${#modules[@]} -eq 0 ]]; then
        tui_error "No installer modules found under $dir"
        return 1
    fi
    printf '\n'
    for name in "${modules[@]}"; do
        index=$((index + 1))
        tui_item "$index" "${name%.sh}" ""
    done
    tui_footer "Cancel the module selection"
    printf '\n'
    tui_read "Module number > " || return 1
    choice="$TUI_REPLY"
    if ! tui_menu_index "$choice" "${#modules[@]}"; then
        tui_error "Enter a number between 1 and ${#modules[@]}."
        return 1
    fi
    for name in "${modules[@]}"; do
        i=$((i + 1))
        if [[ "$i" -eq "$choice" ]]; then
            pick="${name%.sh}"
            break
        fi
    done
    [[ -n "$pick" ]] || return 1
    BF_CMD+=(--only "$pick")
    tui_info "Selected module: $pick"
    return 0
}

