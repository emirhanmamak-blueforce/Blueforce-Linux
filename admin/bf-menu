    local choice
    while true; do
        tui_screen "5) Device information" "Read-only: nothing here changes a device"
        tui_section "This device"
        tui_item 1 "Identity" "hostname, device id, dealer number"
        tui_item 2 "Health summary" "bf-status"
        tui_item 3 "Provisioning and enrollment state" "state.json whitelist + bf-enrollment-status"
        tui_item 4 "Network" "addresses, route, DNS, WireGuard peers"
        tui_item 5 "Disk, memory, CPU" "df, free, load"
        tui_item 6 "Installed pinned packages" "dpkg-query"
        tui_item 7 "Service status" "ssh, xrdp, rustdesk, docker, wg, meshagent"
        tui_item 8 "Recent journal errors" "journalctl -p err"
        tui_section "The fleet"
        tui_item 9 "Inventory summary" "waves, groups, counts"
        tui_item 10 "Resolve a target" "check a dealer number or group"
        tui_footer
        if ! tui_read "Choice > "; then bf_quit; fi
        choice="$TUI_REPLY"
        case "$choice" in
            0) return 0 ;;
            q|Q) bf_quit ;;
            1) bf_info_identity; tui_pause ;;
            2) bf_run_tool bf-status; tui_pause ;;
            3) bf_info_state; tui_pause ;;
            4) bf_info_network; tui_pause ;;
            5) bf_info_resources; tui_pause ;;
            6) bf_info_packages; tui_pause ;;
            7) bf_info_services; tui_pause ;;
            8) bf_info_journal; tui_pause ;;
            9) bf_show_targets; tui_pause ;;
            10) bf_info_resolve_target; tui_pause ;;
