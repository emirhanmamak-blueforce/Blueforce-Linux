bf_info_identity() {
    local host dealer device_id
    host="$(hostname 2>/dev/null || echo unknown)"
    printf '\n'
    tui_section "Identity"
    tui_kv "Hostname (machine)" "$host"
    if dealer="$(bf_host_to_dealer "$host")"; then
        tui_kv "Dealer number" "$dealer"
        tui_kv "Device ID (human)" "$(bf_dealer_to_device_id "$dealer")"
    else
        tui_warn "Hostname is not bf-<8 digits>; it does not match the naming standard (docs/02)."
        tui_note "The installer sets it from --dealer-id: sudo $BF_MENU_NAME -> category 1"
    fi
    if [[ -r /var/lib/blueforce/state.json ]]; then
        device_id="$(bf_state_value device_id || true)"
        [[ -n "$device_id" ]] && tui_kv "state.json device_id" "$device_id"
    fi
    tui_kv "Kernel" "$(uname -sr 2>/dev/null || echo unknown)"
    tui_kv "Console" "$BF_MENU_NAME $BF_MENU_VERSION"
    return 0
}

# bf_state_value KEY -- read one whitelisted key from /var/lib/blueforce/state.json.
# Only non-secret identity/lifecycle fields are ever extracted: the file is read
# through a whitelist so a future token field can never leak into the UI or log.
BF_STATE_ALLOWED_KEYS="phase enrollment_status fleet_status device_id provisioning_id"
bf_state_value() {
    local key="$1" state="/var/lib/blueforce/state.json"
    [[ -r "$state" ]] || return 1
    [[ " $BF_STATE_ALLOWED_KEYS " == *" $key "* ]] || return 1
    if command -v python3 >/dev/null 2>&1; then
        python3 -c '
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        data = json.load(handle)
except Exception:
    sys.exit(1)
if not isinstance(data, dict):
    sys.exit(1)
value = data.get(sys.argv[2])
if value is None or isinstance(value, bool):
    sys.exit(1)
sys.stdout.write(str(value) + "\n")
' "$state" "$key" 2>/dev/null || return 1
        return 0
    fi
    awk -v pattern="\"$key\"" '
        index($0, pattern) {
            line = $0
            sub(/^[^:]*:[[:space:]]*/, "", line)
            gsub(/^"|"[,]?$/, "", line)
            print line; exit
        }' "$state" || return 1
    return 0
}

bf_info_state() {
    local key value
    printf '\n'
    tui_section "Provisioning and enrollment state"
    if [[ -r /var/lib/blueforce/state.json ]]; then
        for key in phase enrollment_status fleet_status device_id provisioning_id; do
            value="$(bf_state_value "$key" || true)"
            [[ -n "$value" ]] && tui_kv "$key" "$value"
        done
        tui_note "Only the identity/lifecycle whitelist above is read; tokens and keys are never printed."
    else
        tui_warn "/var/lib/blueforce/state.json is missing: the device has not been provisioned by the installer."
    fi
    printf '\n'
    printf '   %sProvisioning : PROVISIONED_OFFLINE -> Enrollment : ENROLLED -> Fleet State : READY%s\n' "$C_DIM" "$C_RESET"
    tui_note "Forward-only state machine; READY requires verified central evidence (docs/29)."
    return 0
}

bf_info_network() {
    printf '\n'
    tui_section "Network"
    if command -v ip >/dev/null 2>&1; then
        bf_show_local_cmd "Interfaces" ip -brief address
    fi
    if command -v ip >/dev/null 2>&1; then
        bf_show_local_cmd "Default routes" ip route show default
    fi
    if [[ -r /etc/resolv.conf ]]; then
        bf_show_local_cmd "DNS servers (nameserver lines only)" awk '/^nameserver/{print}' /etc/resolv.conf
    fi
    if command -v wg >/dev/null 2>&1; then
        bf_show_local_cmd "WireGuard listen port" wg show wg0 listen-port
        bf_show_local_cmd "WireGuard peer count" sh -c 'wg show wg0 peers | wc -l'
        bf_show_local_cmd "WireGuard handshakes (epoch, no keys)" wg show wg0 latest-handshakes
    else
        tui_note "wg is not installed; WireGuard channels are not configured on this device."
    fi
    tui_note "WireGuard private and preshared keys are never requested, displayed or logged."
    return 0
}

bf_info_resources() {
    printf '\n'
    tui_section "Resources"
    bf_show_local_cmd "Filesystems" df -h
    bf_show_local_cmd "Memory" free -h
    bf_show_local_cmd "Load average and uptime" uptime
    return 0
}

bf_info_packages() {
    printf '\n'
    tui_section "Installed versions"
    if command -v dpkg-query >/dev/null 2>&1; then
        # shellcheck disable=SC2016  # dpkg field syntax, not a shell expansion
        bf_show_local_cmd "Pinned packages" dpkg-query -W -f='${Package} ${Version} ${Status}\n' \
            docker-ce wireguard rustdesk xrdp openssh-server
    else
        tui_warn "dpkg-query is not available on this machine."
    fi
    return 0
}

bf_info_services() {
    printf '\n'
    tui_section "Service status (read-only)"
    if ! command -v systemctl >/dev/null 2>&1; then
        tui_warn "systemctl is not available on this machine."
        return 0
    fi
    bf_show_local_cmd "Units" systemctl is-active ssh sshd xrdp rustdesk docker wg-quick@wg0 meshagent cron
    return 0
}

bf_info_journal() {
    printf '\n'
    tui_section "Recent journal errors"
    if command -v journalctl >/dev/null 2>&1; then
        bf_show_local_cmd "Errors (last 20)" journalctl -p err -n 20 --no-pager
    else
        tui_warn "journalctl is not available on this machine."
    fi
    return 0
}

bf_info_resolve_target() {
    local word mode="any" answer
    printf '\n'
    tui_section "Resolve a target"
    tui_note "Accepts a dealer number, a group name, 'all' or a bf-<dealer> hostname."
    tui_read "Target > " || return 1
    word="$TUI_REPLY"
    if [[ -z "$word" ]]; then
        return 1
    fi
    if ! bf_require_inventory; then
        return 1
    fi
    if tui_confirm "Is this target for a wave-scoped operation?"; then
        mode="wave"
    fi
    answer="$word"
    if bf_target_parse "$answer" "$mode"; then
        printf '\n'
        tui_kv "Kind" "$BF_TARGET_KIND"
        tui_kv "Ansible --limit" "$BF_TARGET_LIMIT"
        tui_kv "Wave" "${BF_TARGET_WAVE:-none}"
        tui_kv "Devices" "$BF_TARGET_COUNT"
        printf '\n'
        tui_note "Example: ansible-playbook -i $BF_INVENTORY $BF_REPO/$PLAYBOOK_DIR_REL/bf-ping.yml --limit $BF_TARGET_LIMIT"
    else
        tui_warn "That target cannot be used."
    fi
    return 0
}

# ---------------------------------------------------------------------------
# Main menu
# ---------------------------------------------------------------------------
bf_main_menu() {
    local choice
    while true; do
        tui_screen "Blueforce operator console $BF_MENU_VERSION" "repo: $BF_REPO"
        if [[ "$BF_DRY_RUN" -eq 1 ]]; then
            tui_warn "DRY-RUN MODE: commands are printed, never executed."
        fi
        if ! bf_have_ansible; then
            tui_warn "ansible-playbook not found: categories 2, 3 and 5-fleet need Ansible."
        fi
        tui_section "Categories"
        tui_item 1 "Installation" "this device, local one-click installer"
        tui_item 2 "Device operations" "fleet playbooks, explicit target"
        tui_item 3 "Central (preparation)" "verify and prepare central integration"
        tui_item 4 "Tools" "repository and local helpers"
        tui_item 5 "Device information" "read-only information screens"
        printf '\n'
        tui_hr '-'
        printf '   %s%2s%s) %s\n' "$C_BOLD" "q" "$C_RESET" "Quit the console"
        printf '   %sLog:%s %s\n' "$C_DIM" "$C_RESET" "$BF_LOG_FILE"
        tui_hr '-'
        if ! tui_read "Choice > "; then bf_quit; fi
        choice="$TUI_REPLY"
        case "$choice" in
            1) bf_cat_install ;;
            2) bf_cat_devices ;;
            3) bf_cat_central ;;
            4) bf_cat_tools ;;
            5) bf_cat_info ;;
            q|Q) bf_quit ;;
            0) tui_note "Already at the top level."; tui_pause ;;
            *) tui_error "Unknown choice '$choice'."; tui_pause ;;
        esac
    done
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
main() {
    bf_parse_args "$@"
    BF_LOG_REQUESTED="$BF_LOG_FILE"
    bf_resolve_repo
    trap bf_cleanup EXIT
    # shellcheck source=lib/tui.sh disable=SC1091
    source "$BF_REPO/admin/lib/tui.sh"
    tui_init_colors "${TUI_COLOR_MODE:-auto}"
    # shellcheck source=lib/targets.sh disable=SC1091
    source "$BF_REPO/admin/lib/targets.sh"
    bf_log_init

    if [[ "$BF_LIST_TARGETS" -eq 1 ]]; then
        bf_show_targets
        exit $?
    fi
    if [[ "$BF_LIST" -eq 1 ]]; then
        bf_print_catalogue
        exit 0
    fi

    bf_log "SESSION" "$BF_MENU_NAME $BF_MENU_VERSION start uid=$(id -u) repo=$BF_REPO dry_run=$BF_DRY_RUN"
    if ! bf_require_inventory; then
        tui_warn "Starting without a usable inventory: fleet categories will explain what is missing."
        BF_INVENTORY=""
    fi
    bf_main_menu
}

main "$@"
