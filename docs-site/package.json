{
  "name": "blueforce-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Blueforce fleet documentation site. Source of truth is ../docs/*.md; this package only builds the site.",
  "scripts": {
    "sync": "./sync-docs.sh",
    "prestart": "./sync-docs.sh",
    "prebuild": "./sync-docs.sh",
    "start": "docusaurus start --host 127.0.0.1 --port 3000",
    "start:intranet": "docusaurus start --host 0.0.0.0 --port 3000",
    "build": "docusaurus build",
    "serve": "docusaurus serve build --host 127.0.0.1 --port 3000",
    "serve:intranet": "docusaurus serve build --host 0.0.0.0 --port 3000",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.49.2",
    "@mermaid-js/layout-elk": "0.1.9",
    "@mdx-js/react": "3.0.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": { "typescript": "5.5.4" },
  "engines": { "node": ">=18.0" }
}