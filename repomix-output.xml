#!/usr/bin/env bash
# Install bf-status and run it for the first time.
# Idempotent: safe to re-run. Supports --check for read-only verification.
# Exit codes: 0 = OK, 3 = SKIP (optional step, nothing to do).
set -euo pipefail

MODULE="17-healthcheck"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
DEALER_ID="${DEALER_ID:-}"
BF_HOSTNAME="${BF_HOSTNAME:-}"
BF_DEVICE="${BF_DEVICE:-}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"

log() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [17-healthcheck] $msg" | tee -a "$LOG_FILE"
}

CHECK_MODE=0
if [[ "${1:-}" == "--check" ]]; then CHECK_MODE=1; fi
STATUS_BIN="/usr/local/bin/bf-status"

write_bf_status() {
    cat > /tmp/bf-status.bf <<'EOF'
#!/usr/bin/env bash
# bf-status: quick device health summary. Exit 0 = healthy, 1 = problem.
set -uo pipefail
fails=0
say() { local st="$1"; shift; echo "[$st] $*"; [[ "$st" == "PASS" ]] || fails=$((fails+1)); }

ID_FILE="/var/lib/blueforce/dealer-id"
if [[ -f "$ID_FILE" && "$(cat $ID_FILE)" =~ ^[0-9]{8}$ ]]; then
    DID=$(cat "$ID_FILE")
    [[ "$(hostname)" == "bf-$DID" ]] && say PASS "identity BF-$DID / $(hostname)" || say FAIL "hostname $(hostname) != bf-$DID"
else
    say FAIL "dealer-id file missing or invalid"
fi
systemctl is-enabled --quiet wg-quick@wg0 2>/dev/null && say PASS "wireguard enabled" || say FAIL "wireguard not enabled"
systemctl is-active --quiet docker 2>/dev/null && say PASS "docker running" || say FAIL "docker not running"
ufw status 2>/dev/null | grep -q "Status: active" && say PASS "firewall active" || say FAIL "firewall inactive"
systemctl is-enabled apt-daily.timer 2>/dev/null | grep -q masked && say PASS "auto-update off" || say FAIL "auto-update timer live"
systemctl is-enabled --quiet prometheus-node-exporter 2>/dev/null || systemctl is-enabled --quiet node_exporter 2>/dev/null     && say PASS "monitoring enabled" || say FAIL "monitoring not enabled"
echo "bf-status: $fails failing check(s)"
exit "$fails"
EOF
    mv /tmp/bf-status.bf "$STATUS_BIN"
    chmod 755 "$STATUS_BIN"
}

if [[ "$CHECK_MODE" -eq 1 ]]; then
    [[ -x "$STATUS_BIN" ]] || { log "FAIL(check): bf-status missing"; exit 1; }
