<file path="docs-site/sync-docs.sh">
#!/usr/bin/env bash
# One-way sync: repo docs (../docs/*.md) -> site content (./docs/).
# The repo Markdown files are the single source of truth; never edit ./docs by hand.
set -euo pipefail

SITE_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC_DIR="$SITE_DIR/../docs"
DST_DIR="$SITE_DIR/docs"

mkdir -p "$DST_DIR"

# Copy current sources.
cp -f "$SRC_DIR"/*.md "$DST_DIR"/

# Remove stale files that no longer exist upstream (keep .gitkeep).
for f in "$DST_DIR"/*.md; do
  base="$(basename "$f")"
  if [ ! -f "$SRC_DIR/$base" ]; then
    rm -f "$f"
  fi
done

# MDX compatibility: a bare "<" followed by a letter/digit in prose is parsed
# as JSX and breaks the build (e.g. "<15 dk"). Escape it as "&lt;" ONLY
# outside fenced code blocks and inline code spans, where "<" is safe
# (mermaid "<br/>", placeholders like `BF-<no>`). Rendered text is unchanged.
python3 - "$DST_DIR" <<'EOF'
import re, sys, glob, os
dst = sys.argv[1]
pat = re.compile(r'<(?=[A-Za-z0-9])')
for f in glob.glob(os.path.join(dst, '*.md')):
    out, in_fence = [], False
    for line in open(f, encoding='utf-8'):
        if line.startswith('```'):
            in_fence = not in_fence
            out.append(line)
            continue
        if in_fence:
            out.append(line)
            continue
        # Split inline code spans; escape only the prose parts.
        parts = re.split(r'(`[^`]*`)', line)
        for i in range(0, len(parts), 2):
            parts[i] = pat.sub('&lt;', parts[i])
        out.append(''.join(parts))
    open(f, 'w', encoding='utf-8').write(''.join(out))
EOF

echo "Synced $(ls "$SRC_DIR"/*.md | wc -l) files into docs-site/docs."
</file>

