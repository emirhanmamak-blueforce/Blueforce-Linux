      {% endif %}
      [Peer]
      PublicKey = {{ wg_hub_public_key }}
      Endpoint = {{ wg_hub_endpoint }}
      AllowedIPs = {{ wg_allowed_ips }}
      PersistentKeepalive = {{ wg_keepalive }}
