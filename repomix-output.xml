<file path="monitoring/prometheus/targets/README.md">
# File-based service discovery for the 700-device fleet.
#
# Prometheus watches this directory (refresh 30s); adding or removing a
# `*.json` file takes effect without a reload or restart.
#
# Per-device entry template (WireGuard address as target, identity label
# contract `device_id="BF-<no>"` on every target):
#
#   [
#     {
#       "targets": ["10.7.0.11"],
#       "labels": {"device_id": "BF-12010193", "site": "pilot", "job": "node"}
#     }
#   ]
#
# Scale-out: generate one file per site/region (e.g. `site-ankara.json`)
# from the Ansible inventory; keep each file under a few thousand targets.
</file>

<file path="monitoring/prometheus/alerts.yml">
# Fleet alert rules. Severity: critical pages the on-call admin (14-MONITORING).
# Notification endpoints (SMS/e-mail/webhook) are wired in the central
# Grafana Alerting / Alertmanager setup, not in this file.
# All expressions assume 60s scrape interval.

groups:
  - name: fleet
    interval: 60s
    rules:
      # Device does not answer scrapes for 5 minutes -> presumed offline.
      - alert: FleetOffline
        expr: up{job="node"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Device {{ $labels.device_id }} is offline"
          description: "No successful scrape for 5m (instance {{ $labels.instance }}). Check Uptime Kuma last-seen and field power/network."

      # Root filesystem less than 10% available for 10 minutes.
      - alert: FleetDiskFull
        expr: |
          (
            node_filesystem_avail_bytes{job="node", mountpoint="/", fstype!~"tmpfs|overlay"}
            /
            node_filesystem_size_bytes{job="node", mountpoint="/", fstype!~"tmpfs|overlay"}
          ) < 0.10
        for: 10m
        labels:
          severity: critical
        annotations:
          summary: "Device {{ $labels.device_id }} disk almost full"
          description: "Root filesystem <10% available for 10m on {{ $labels.instance }}."

      # Boot time changed recently -> unexpected reboot (power loss or crash).
      - alert: FleetUnexpectedReboot
        expr: time() - node_boot_time_seconds{job="node"} < 15 * 60
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Device {{ $labels.device_id }} rebooted unexpectedly"
          description: "{{ $labels.instance }} booted less than 15m ago. Correlate with power-loss recovery (16-POWER-LOSS)."

      # unattended-upgrades must stay DISABLED (K-11); 1 means the lock was broken.
      # Source: textfile metric unattended_upgrade_active.
      - alert: FleetSecurityUpdatesViolation
        expr: unattended_upgrade_active{job="node"} == 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Device {{ $labels.device_id }} has unattended-upgrades enabled"
          description: "Update policy lock (K-11) violated on {{ $labels.instance }}. Disable unattended-upgrades per 10-UPDATE."
</file>

<file path="monitoring/prometheus/prometheus.yml">
# Prometheus configuration for the Blueforce fleet.
# Scrape interval 60s keeps cardinality/storage tractable at 700 nodes.
# Fleet targets scale via file-based service discovery: add/remove entries
# in targets/fleet.json without reloading Prometheus (refresh_interval 30s).

global:
  scrape_interval: 60s
  scrape_timeout: 10s
  evaluation_interval: 60s
  external_labels:
    fleet: blueforce

rule_files:
  - alerts.yml

scrape_configs:
  # Prometheus self-monitoring.
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  # Field devices: Node Exporter (:9100) + textfile collector metrics.
  # Identity label contract: device_id="BF-<no>" on every target.
  - job_name: node
    file_sd_configs:
      - files: ["/etc/prometheus/targets/*.json"]
        refresh_interval: 30s
    relabel_configs:
      - source_labels: [__address__]
        target_label: __address__
        regex: (.+)
        replacement: ${1}:9100
      - source_labels: [device_id]
        target_label: device_id
        regex: (.+)
        replacement: ${1}
    metric_relabel_configs:
      # Enforce the device_id label contract; drop series without it.
      - source_labels: [device_id]
        regex: .+
        action: keep
</file>

