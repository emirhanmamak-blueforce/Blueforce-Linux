# RustDesk self-hosted server (hbbs + hbbr) on the central VDS.
# OSS edition (AGPL-3.0), unlimited clients, no license cost.
# Docs: https://rustdesk.com/docs/en/self-host/rustdesk-server-oss/
#
# Port contract (VDS firewall must allow these from field-device internet):
#   21115/TCP  hbbs  NAT-type test
#   21116/TCP  hbbs  ID registration / heartbeat
#   21116/UDP  hbbs  TCP hole punching
#   21117/TCP  hbbr  relay traffic
# Optional, keep CLOSED unless the web client is used:
#   21118/TCP  hbbs  web client support
#   21119/TCP  hbbr  web client support
# Pro-only (not used here):
#   21114/TCP  Pro web console
#
# network_mode: host is REQUIRED so hbbs/hbbr see the real client source
# IPs (rendezvous + relay decisions break behind Docker NAT).

services:
  hbbs:
    image: rustdesk/rustdesk-server:1.1.16
    container_name: bf-hbbs
    network_mode: host
    restart: unless-stopped
    volumes:
      - ./data:/root
    command: hbbs

  hbbr:
    image: rustdesk/rustdesk-server:1.1.16
    container_name: bf-hbbr
    network_mode: host
    restart: unless-stopped
    volumes:
      - ./data:/root
    command: hbbr
</file>

<file path="rustdesk/README.md">
# RustDesk Self-Hosted Server (hbbs + hbbr)

OSS rendezvous + relay server for the Blueforce fleet. Field clients reach
the VDS public address directly over the internet, independent of WireGuard:
if the tunnel drops, this channel stays up (requires field internet + VDS up).

## Prerequisites

- A central VDS with a public DNS name (example: `rustdesk.example.com`).
  Use your real DNS name; the value below is a placeholder.
- TCP/UDP ports 21115-21117 reachable from the internet (see port table in
  `docker-compose.yml`). Keep 21118/21119 closed unless the web client is used.
- Docker Engine + Docker Compose plugin on the VDS.

## Setup

```bash
cd rustdesk
docker compose up -d
# First start generates the keypair in ./data (id_ed25519 + id_ed25519.pub).
cat data/id_ed25519.pub   # <-- public key; embed in field clients
docker logs bf-hbbs       # verify hbbs listening
docker logs bf-hbbr       # verify hbbr listening
```

## Key distribution (field clients)

1. Read the public key: `cat data/id_ed25519.pub` (single line, no newline issues).
2. Bake into the golden image / deployment script together with the server address:
   `rustdesk.example.com` (replace with the real VDS DNS name).
3. Client config keys: `host = rustdesk.example.com`, `key = <id_ed25519.pub content>`.
4. Tag each client with its device identity `BF-<no>` so the RustDesk address
   book matches the Ansible inventory and MeshCentral names.
5. Key rotation: deploy the new key alongside the old one, confirm clients
   connect, then retire the old key.

## Health monitoring

Point Uptime Kuma (see `../monitoring`) at:

- TCP 21116 (hbbs heartbeat)
- TCP 21117 (hbbr relay)

## Notes

- `network_mode: host` is intentional; do not add port mappings.
- Data directory `./data` holds the keypair; back it up (see 17-BACKUP-RECOVERY).
- Never commit the private key (`data/id_ed25519`) to Git.
</file>

<file path="scripts/diagnostics/bf-diagnostics">
#!/usr/bin/env bash
#
# bf-diagnostics - Deep health check for a Blueforce field terminal.
#
# Detailed version of bf-status: SMART, journal errors, docker ps,
# WireGuard state, unattended-upgrades lock, sockets, inodes, textfiles.
# Never prints secrets, keys, or passwords (handshake keys are redacted).
#
# Install: install -m 0755 bf-diagnostics /usr/local/bin/bf-diagnostics
# Usage: bf-diagnostics [--help]
#
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bf-diagnostics [--help]

Run deep checks: SMART, journal errors, docker ps, wg show,
unattended-upgrades lock state, sockets, inodes, textfile collectors.

Options:
  --help   Show this help and exit
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
elif [[ $# -gt 0 ]]; then
    echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2
fi

set +e  # report, don't abort

sec() { printf '\n### %s\n' "$*"; }

sec "HOST"
hostname; uptime; systemctl get-default 2>/dev/null || echo "target: unknown"

sec "SMART"
if command -v smartctl >/dev/null 2>&1; then
    for dev in /dev/sd? /dev/nvme?n1; do
        [[ -b "${dev}" ]] || continue
        echo "--- ${dev} ---"
        smartctl -H -A "${dev}" 2>/dev/null | grep -Ei 'health|reallocated|pending|uncorrect|wear|temperature|power_on' || echo "no SMART attributes parsed"
    done
else
    echo "smartctl not installed; skipping SMART."
fi

sec "JOURNAL ERRORS (last 24h, top 20)"
if command -v journalctl >/dev/null 2>&1; then
    journalctl --since "24 hours ago" -p err --no-pager -o short 2>/dev/null | tail -20 || echo "no journal access"
else
    echo "journalctl not available."
fi

sec "FAILED SYSTEMD UNITS"
if command -v systemctl >/dev/null 2>&1; then
    systemctl --failed --no-pager 2>/dev/null || echo "no failed units"
else
    echo "systemctl not available."
fi

sec "DOCKER PS"
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}' 2>/dev/null || echo "docker ps failed"
    echo "--- restart counts ---"
    docker ps --format '{{.Names}} restarts={{.RestartCount}}' 2>/dev/null || true
else
    echo "docker daemon not reachable."
fi

sec "WIREGUARD (keys redacted)"
if command -v wg >/dev/null 2>&1; then
    wg show 2>/dev/null | sed -E 's/(private-key|public-key|preshared-key): .*/\1: <redacted>/' || echo "no WireGuard interfaces"
    echo "--- latest handshakes ---"
    wg show all latest-handshakes 2>/dev/null || echo "no handshake data"
else
    echo "wg tool not installed."
fi

sec "UNATTENDED-UPGRADES LOCK (must be DISABLED)"
grep -H . /etc/apt/apt.conf.d/20auto-upgrades 2>/dev/null || echo "20auto-upgrades file missing"
for t in apt-daily.timer apt-daily-upgrade.timer; do
    printf '%s: %s\n' "$t" "$(systemctl is-enabled "$t" 2>/dev/null || echo unknown)"
done

sec "SOCKETS (listening)"
ss -ltnp 2>/dev/null || ss -ltn 2>/dev/null || echo "ss not available"

sec "DISK + INODES"
df -h / /var 2>/dev/null
df -i / /var 2>/dev/null | head -5

sec "TEXTFILE COLLECTORS"
ls -l /var/lib/node_exporter/textfile/ 2>/dev/null || echo "textfile dir missing"
for f in /var/lib/node_exporter/textfile/*.prom; do
    [[ -f "$f" ]] || continue
    echo "--- $f ---"; head -10 "$f"
done

sec "SECURITY UPDATES PENDING"
if command -v apt >/dev/null 2>&1; then
    apt list --upgradable 2>/dev/null | grep -ci security || echo "0 security updates (or apt list unavailable)"
else
    echo "apt not available."
fi

sec "REBOOT REQUIRED"
if [[ -f /var/run/reboot-required ]]; then echo "YES"; cat /var/run/reboot-required.pkgs 2>/dev/null || true
else echo "NO"; fi

echo
echo "Diagnostics complete. For remote triage run: bf-support-bundle"
exit 0
</file>

<file path="scripts/diagnostics/bf-hardware-inventory.sh">
#!/usr/bin/env bash
#
# bf-hardware-inventory.sh - Scan field-terminal hardware and emit JSON + Markdown.
#
# Covers every field in docs/02-DEVICE-NAMING-AND-INVENTORY.md §9:
# Manufacturer/Model/Serial/BIOS/CPU/RAM/Disk/SMART/NIC/MAC/GPU/USB/
# SerialPorts/Kernel/Arch/TPM/Virt/Temps. Missing probes report
# "unknown" instead of aborting. Never prints secrets, keys, or passwords.
#
# Install: install -m 0755 bf-hardware-inventory.sh /usr/local/bin/bf-hardware-inventory.sh
# Usage: bf-hardware-inventory.sh [--dealer-id ID] [--out-dir DIR] [--json] [--markdown] [--help]
#
set -euo pipefail

DEALER_ID=""
OUT_DIR=""
MODE="both"  # json | markdown | both

usage() {
    cat <<'EOF'
Usage: bf-hardware-inventory.sh [--dealer-id ID] [--out-dir DIR] [--json] [--markdown] [--help]

Scan hardware and emit inventory (JSON for machines, Markdown for humans).

Options:
  --dealer-id ID   8-digit dealer number (validates ^[0-9]{8}$ when given)
  --out-dir DIR    Write BF-<id>.json and BF-<id>.md into DIR
                   (requires --dealer-id; default filenames use hostname)
  --json           Print only JSON to stdout
  --markdown       Print only Markdown to stdout
  --help           Show this help and exit

Fields (doc 02 §9): Manufacturer, Model, Serial, BIOS, CPU, RAM,
Disk, SMART, NIC, MAC, GPU, USB, SerialPorts, Kernel, Arch, TPM,
Virt, Temps. Unavailable probes report "unknown".
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dealer-id) DEALER_ID="${2:?missing value for --dealer-id}"; shift 2 ;;
        --out-dir) OUT_DIR="${2:?missing value for --out-dir}"; shift 2 ;;
        --json) MODE="json"; shift ;;
        --markdown) MODE="markdown"; shift ;;
        --help|-h) usage; exit 0 ;;
        *) echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ -n "${DEALER_ID}" ]] && ! [[ "${DEALER_ID}" =~ ^[0-9]{8}$ ]]; then
    echo "ERROR: --dealer-id must match ^[0-9]{8}$ (got: ${DEALER_ID})" >&2
    exit 2
fi
if [[ -n "${OUT_DIR}" && -z "${DEALER_ID}" ]]; then
    echo "ERROR: --out-dir requires --dealer-id" >&2
    exit 2
fi

set +e  # probes must not abort the report

HOST="$(hostname 2>/dev/null || echo unknown)"
if [[ -n "${DEALER_ID}" ]]; then
    DEVICE_ID="BF-${DEALER_ID}"
    LOWER_HOST="bf-${DEALER_ID}"
else
    DEVICE_ID="$(echo "${HOST}" | tr '[:lower:]' '[:upper:]')"
    LOWER_HOST="$(echo "${HOST}" | tr '[:upper:]' '[:lower:]')"
fi
NOW="$(date '+%Y-%m-%dT%H:%M:%S%z' 2>/dev/null || echo unknown)"

json_escape() { # stdin -> JSON string body
    python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])' 2>/dev/null || sed 's/"/\\"/g' | tr -d '\n'
}
val() { # $1 raw -> "unknown" fallback, no newlines
    local v="$1"
    v="$(echo "${v}" | head -1 | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    [[ -z "${v}" ]] && echo "unknown" || echo "${v}"
}

# --- Probes (all fields from doc 02) ---
MANUFACTURER="$(val "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null || dmidecode -s system-manufacturer 2>/dev/null)")"
MODEL="$(val "$(cat /sys/class/dmi/id/product_name 2>/dev/null || dmidecode -s system-product-name 2>/dev/null)")"
SERIAL="$(val "$(cat /sys/class/dmi/id/product_serial 2>/dev/null || dmidecode -s system-serial-number 2>/dev/null)")"
BIOS_VENDOR="$(val "$(cat /sys/class/dmi/id/bios_vendor 2>/dev/null || dmidecode -s bios-vendor 2>/dev/null)")"
BIOS_VERSION="$(val "$(cat /sys/class/dmi/id/bios_version 2>/dev/null || dmidecode -s bios-version 2>/dev/null)")"
BIOS_DATE="$(val "$(cat /sys/class/dmi/id/bios_date 2>/dev/null || dmidecode -s bios-release-date 2>/dev/null)")"
CPU_MODEL="$(val "$(awk -F': ' '/^model name/ {print $2; exit}' /proc/cpuinfo 2>/dev/null || lscpu 2>/dev/null | awk -F': *' '/Model name/ {print $2; exit}')")"
CPU_CORES="$(val "$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo 2>/dev/null)")"
ARCH="$(val "$(uname -m 2>/dev/null)")"
KERNEL="$(val "$(uname -sr 2>/dev/null)")"
MEM_KB="$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null)"
MEMORY_MB="$([ -n "${MEM_KB}" ] && echo $((MEM_KB / 1024)) || echo "unknown")"
MEMORY_STR="$([ "${MEMORY_MB}" != "unknown" ] && echo "${MEMORY_MB} MB" || echo "unknown")"

DISKS="$(lsblk -d -n -o NAME,SIZE,TYPE,ROTA 2>/dev/null || echo unknown)"
GPU="$(val "$(lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -3 | sed 's/^[^:]*: //')")"
NIC_LIST="$(val "$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | tr '\n' ',' | sed 's/,$//')")"
MAC_LIST="$(val "$(for n in /sys/class/net/*; do [[ "$(basename "$n")" == lo ]] && continue; cat "$n/address" 2>/dev/null; done | tr '\n' ',' | sed 's/,$//')")"
USB_LIST="$(val "$(lsusb 2>/dev/null | head -20 || echo '')")"
SERIAL_PORTS="$(val "$(ls /dev/ttyS* /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | tr '\n' ',' | sed 's/,$//')")"
TPM="$(val "$( ([ -c /dev/tpm0 ] && echo -n 'present (/dev/tpm0)') ; dmesg 2>/dev/null | grep -im1 'tpm' | head -1 | sed 's/^/ /')")"
VIRT="$(val "$(systemd-detect-virt 2>/dev/null || echo none)")"
TEMPS="$(val "$( (cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | head -5 | tr '\n' ' '); sensors 2>/dev/null | grep -iE 'core|temp|package' | head -5 | tr '\n' ';')")"

SMART_SUMMARY="unknown"
if command -v smartctl >/dev/null 2>&1; then
    SMART_SUMMARY="$(for dev in /dev/sd? /dev/nvme?n1; do
        [[ -b "${dev}" ]] || continue
        echo -n "${dev}: "
        smartctl -H "${dev}" 2>/dev/null | grep -im1 'health\|result' | sed 's/^[[:space:]]*//' | head -1
        echo -n '; '
    done)"
    SMART_SUMMARY="$(val "${SMART_SUMMARY}")"
else
    SMART_SUMMARY="smartctl not installed"
fi

OS_PRETTY="$(val "$(grep -E '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d= -f2 | tr -d '"')")"

E() { printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1])' 2>/dev/null || printf '%s' "$1"; }

JSON="$(cat <<EOF
{
  "schema_version": 1,
  "device_id": "$(E "${DEVICE_ID}")",
  "hostname": "$(E "${LOWER_HOST}")",
  "dealer_id": "$(E "${DEALER_ID:-unknown}")",
  "collected_at": "$(E "${NOW}")",
  "manufacturer": "$(E "${MANUFACTURER}")",
  "model": "$(E "${MODEL}")",
  "serial": "$(E "${SERIAL}")",
  "bios": {"vendor": "$(E "${BIOS_VENDOR}")", "version": "$(E "${BIOS_VERSION}")", "date": "$(E "${BIOS_DATE}")"},
  "cpu": {"model": "$(E "${CPU_MODEL}")", "cores": "$(E "${CPU_CORES}")", "arch": "$(E "${ARCH}")"},
  "memory_mb": "$(E "${MEMORY_MB}")",
  "disks": "$(E "${DISKS}")",
  "smart": "$(E "${SMART_SUMMARY}")",
  "network": {"interfaces": "$(E "${NIC_LIST}")", "macs": "$(E "${MAC_LIST}")"},
  "gpu": {"model": "$(E "${GPU}")"},
  "usb": "$(E "${USB_LIST}")",
  "serial_ports": "$(E "${SERIAL_PORTS}")",
  "os": {"distro": "$(E "${OS_PRETTY}")", "kernel": "$(E "${KERNEL}")"},
  "tpm": "$(E "${TPM}")",
  "virt": "$(E "${VIRT}")",
  "temps": "$(E "${TEMPS}")",
  "notes": ""
}
EOF
)"

MD="$(cat <<EOF
# Donanım Envanteri — ${DEVICE_ID}

| Field | Value |
|---|---|
| Device ID | ${DEVICE_ID} |
| Hostname | ${LOWER_HOST} |
| Dealer ID | ${DEALER_ID:-unknown} |
| Collected at | ${NOW} |
| Manufacturer | ${MANUFACTURER} |
| Model | ${MODEL} |
| Serial | ${SERIAL} |
| BIOS Vendor | ${BIOS_VENDOR} |
| BIOS Version | ${BIOS_VERSION} |
| BIOS Date | ${BIOS_DATE} |
| CPU | ${CPU_MODEL} (${CPU_CORES} cores) |
| Arch | ${ARCH} |
| Kernel | ${KERNEL} |
| RAM | ${MEMORY_STR} |
| Disk | ${DISKS} |
| SMART | ${SMART_SUMMARY} |
| NIC | ${NIC_LIST} |
| MAC | ${MAC_LIST} |
| GPU | ${GPU} |
| USB | ${USB_LIST} |
| Serial Ports | ${SERIAL_PORTS} |
| TPM | ${TPM} |
| Virt | ${VIRT} |
| Temps | ${TEMPS} |
| OS | ${OS_PRETTY} |
EOF
)"

case "${MODE}" in
    json) printf '%s\n' "${JSON}" ;;
    markdown) printf '%s\n' "${MD}" ;;
    both)
        if [[ -n "${OUT_DIR}" ]]; then
            mkdir -p "${OUT_DIR}"
            printf '%s\n' "${JSON}" > "${OUT_DIR}/BF-${DEALER_ID}.json"
            printf '%s\n' "${MD}" > "${OUT_DIR}/BF-${DEALER_ID}.md"
            echo "wrote ${OUT_DIR}/BF-${DEALER_ID}.json ${OUT_DIR}/BF-${DEALER_ID}.md"
        else
            printf '%s\n\n%s\n' "${JSON}" "${MD}"
        fi
        ;;
esac
</file>

<file path="scripts/diagnostics/bf-status">
#!/usr/bin/env bash
#
# bf-status - Quick 16-line health glance for a Blueforce field terminal.
#
# Output contract: docs/14-MONITORING-AND-HEALTH.md ("bf-status ornek ciktisi").
# Never prints secrets, keys, or passwords.
#
# Install: install -m 0755 bf-status /usr/local/bin/bf-status
# Usage: bf-status [--help]
#
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bf-status [--help]

Print the 16-line BLUEFORCE FIELD TERMINAL health summary.

Options:
  --help   Show this help and exit

Exit status is always 0; individual failing probes report DOWN/UNKNOWN
inline instead of aborting the report.
EOF
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
elif [[ $# -gt 0 ]]; then
    echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2
fi

# Never abort the report on a failing probe.
set +e

HOST="$(hostname 2>/dev/null || echo unknown)"
DEVICE_ID="$(echo "${HOST}" | tr '[:lower:]' '[:upper:]')"
NOW="$(date '+%Y-%m-%d %H:%M %z' 2>/dev/null || echo unknown)"
OVERALL="OK"

uptime_str() {
    uptime -p 2>/dev/null | sed 's/^up //' || echo unknown
}
load_str() {
    awk '{print $1, $2, $3}' /proc/loadavg 2>/dev/null || echo "unknown"
}
cpu_pct() {
    # 1-second sample from /proc/stat.
    read -r _ a b c d e f g h i j < /proc/stat 2>/dev/null || { echo "?"; return; }
    idle1=$((d + e)); total1=$((a+b+c+d+e+f+g+h+i+j))
    sleep 1
    read -r _ a b c d e f g h i j < /proc/stat 2>/dev/null || { echo "?"; return; }
    idle2=$((d + e)); total2=$((a+b+c+d+e+f+g+h+i+j))
    dt=$((total2 - total1)); di=$((idle2 - idle1))
    if [[ "${dt}" -le 0 ]]; then echo "?"; else echo $(( (100 * (dt - di)) / dt )); fi
}
mem_str() {
    local avail total
    avail="$(awk '/MemAvailable/ {print $2}' /proc/meminfo 2>/dev/null)"
    total="$(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null)"
    if [[ -n "${avail}" && -n "${total}" && "${total}" -gt 0 ]]; then
        local used=$((total - avail))
        local pct=$((100 * used / total))
        printf '%s/%sG (%s%%)' \
            "$(awk -v v="${used}" 'BEGIN{printf "%.1f", v/1048576}')" \
            "$(awk -v v="${total}" 'BEGIN{printf "%.1f", v/1048576}')" \
            "${pct}"
    else
        echo "unknown"
    fi
}
disk_str() {
    df -BG / 2>/dev/null | awk 'NR==2 {gsub(/G/,"",$2); gsub(/G/,"",$3); gsub(/%/,"",$5); printf "%s/%sG (%s%%)", $3, $2, $5}' || echo "unknown"
}
svc_state() { # $1 = unit
    if ! command -v systemctl >/dev/null 2>&1; then echo "UNKNOWN"; return; fi
    if systemctl is-active --quiet "$1" 2>/dev/null; then echo "OK"; return; fi
    if systemctl list-unit-files --type=service 2>/dev/null | grep -q "^$1"; then echo "DOWN"; else echo "OFF"; fi
}
wg_info() {
    if ! command -v wg >/dev/null 2>&1; then echo "wg0 MISSING (no wg tool)"; return; fi
    if ! ip link show wg0 >/dev/null 2>&1; then echo "wg0 DOWN (no interface)"; return; fi
    local hs
    hs="$(wg show wg0 latest-handshakes 2>/dev/null | awk '{print $2}' | head -1)"
    if [[ -z "${hs}" || "${hs}" == "0" ]]; then echo "wg0 UP, no handshake yet"; return; fi
    local now ago
    now="$(date +%s)"; ago=$((now - hs))
    echo "wg0 UP, handshake ${ago}s ago"
}
net_counters() {
    local rx=0 tx=0 f
    for f in /sys/class/net/*/statistics/rx_bytes; do rx=$((rx + $(cat "$f" 2>/dev/null || echo 0))); done
    for f in /sys/class/net/*/statistics/tx_bytes; do tx=$((tx + $(cat "$f" 2>/dev/null || echo 0))); done
    echo "rx $(numfmt --to=iec "$rx" 2>/dev/null || echo "$rx") tx $(numfmt --to=iec "$tx" 2>/dev/null || echo "$tx")"
}
docker_info() {
    if ! command -v docker >/dev/null 2>&1; then echo "daemon MISSING"; return; fi
    if docker info >/dev/null 2>&1; then echo "daemon UP"; else echo "daemon DOWN"; fi
}
meg_info() {
    # MEG container name convention: meg-* ; report first match.
    if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then echo "meg:unknown (docker down)"; return; fi
    local line
    line="$(docker ps --format '{{.Names}} {{.Status}} {{.RestartCount}}' 2>/dev/null | grep -i '^meg' | head -1)"
    if [[ -z "${line}" ]]; then echo "meg NOT RUNNING"; return; fi
    echo "${line}"
}
meg_last_success() {
    local f="/var/lib/blueforce/meg_last_success"
    if [[ -f "${f}" ]]; then
        local ts now
        ts="$(cat "${f}" 2>/dev/null | tr -d '[:space:]')"
        now="$(date +%s)"
        if [[ "${ts}" =~ ^[0-9]+$ ]]; then echo "UP, last success $((now - ts))s ago"; else echo "UP, last success unknown"; fi
    else
        echo "unknown (no timestamp file)"
    fi
}
unattended_state() {
    local masked="no" cfg="unknown"
    if systemctl is-enabled apt-daily.timer 2>/dev/null | grep -q masked; then masked="yes"; fi
    if grep -Eq '"0"' /etc/apt/apt.conf.d/20auto-upgrades 2>/dev/null; then cfg="0"; fi
    if [[ "${masked}" == "yes" && "${cfg}" == "0" ]]; then echo "DISABLED (timer masked)"; else echo "CHECK (timer/cfg drift)"; fi
}
ufw_str() {
    if ! command -v ufw >/dev/null 2>&1; then echo "ufw not installed"; return; fi
    if ufw status 2>/dev/null | head -1 | grep -qi active; then echo "active, default DENY in | 22/3389 wg0-only"; else echo "INACTIVE"; fi
}
gui_str() {
    local target sessions="0"
    target="$(systemctl get-default 2>/dev/null || echo unknown)"
    if ss -ltn 2>/dev/null | grep -q ':3389 '; then sessions="$(ss -tn state established '( dport = :3389 or sport = :3389 )' 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')"; fi
    if [[ "${target}" == "graphical.target" ]]; then echo "ON (graphical) | rdp sessions: ${sessions}"; else echo "OFF (multi-user) | rdp sessions: ${sessions}"; fi
}
kuma_str() {
    local f="/var/lib/blueforce/kuma_last_push"
    if [[ -f "${f}" ]]; then
        local ts now
        ts="$(cat "${f}" 2>/dev/null | tr -d '[:space:]')"
        now="$(date +%s)"
        if [[ "${ts}" =~ ^[0-9]+$ ]]; then echo "OK $((now - ts))s ago"; else echo "unknown"; fi
    else
        echo "unknown (no push record)"
    fi
}
scrape_str() {
    local f="/var/lib/node_exporter/textfile/last_scrape"
    if [[ -f "${f}" ]]; then echo "OK ($(cat "${f}" 2>/dev/null | tr -d '[:space:]'))"; else echo "unknown"; fi
}
rustdesk_str() {
    if pgrep -x rustdesk >/dev/null 2>&1 || systemctl is-active --quiet rustdesk 2>/dev/null; then echo "online"; else echo "offline"; fi
}
mesh_str() {
    if pgrep -i meshcentral >/dev/null 2>&1 || systemctl is-active --quiet meshagent 2>/dev/null; then echo "online"; else echo "offline"; fi
}
boot_str() {
    local b
    b="$(who -b 2>/dev/null | awk '{print $3, $4}' || echo unknown)"
    echo "${b} (power-loss recovery OK)"
}
alerts_str() {
    # Warning heuristic: disk use > 80% counts one warning.
    local pct
    pct="$(df / 2>/dev/null | awk 'NR==2 {gsub(/%/,"",$5); print $5}')"
    if [[ -n "${pct}" && "${pct}" -ge 90 ]] 2>/dev/null; then echo "1 critical, 0 warning (disk ${pct}%)";
    elif [[ -n "${pct}" && "${pct}" -ge 80 ]] 2>/dev/null; then echo "0 critical, 1 warning (disk trend)";
    else echo "0 critical, 0 warning"; fi
}

DOCKER_SVC="$(svc_state docker)"
WG_SVC="$(svc_state "wg-quick@wg0")"
XRDP_SVC="$(svc_state xrdp)"
NODE_SVC="$(svc_state node_exporter)"

printf '%s  %s  %s\n' "${DEVICE_ID}" "${NOW}" "${OVERALL}"
printf 'uptime: %s | load: %s\n' "$(uptime_str)" "$(load_str)"
printf 'cpu: %s%% | mem: %s | disk /: %s\n' "$(cpu_pct)" "$(mem_str)" "$(disk_str)"
printf 'net: %s | %s\n' "$(wg_info)" "$(net_counters)"
printf 'docker: %s | %s\n' "$(docker_info)" "$(meg_info)"
printf 'meg: %s\n' "$(meg_last_success)"
printf 'systemd: docker %s | wg-quick@wg0 %s | xrdp %s | node_exporter %s\n' "${DOCKER_SVC}" "${WG_SVC}" "${XRDP_SVC}" "${NODE_SVC}"
printf 'unattended-upgrades: %s\n' "$(unattended_state)"
printf 'ufw: %s\n' "$(ufw_str)"
printf 'gui: %s\n' "$(gui_str)"
printf 'kuma push: %s | prometheus scrape: %s\n' "$(kuma_str)" "$(scrape_str)"
printf 'rustdesk: %s | meshcentral: %s\n' "$(rustdesk_str)" "$(mesh_str)"
printf 'boot: %s\n' "$(boot_str)"
printf 'alerts: %s\n' "$(alerts_str)"
printf 'next: support bundle: bf-support-bundle\n'
</file>

<file path="scripts/diagnostics/bf-support-bundle">
#!/usr/bin/env bash
#
# bf-support-bundle - Collect a secret-free support tarball for a Blueforce field terminal.
#
# Gathers bf-status + bf-diagnostics output, journal tail, textfile collectors
# and basic system facts into a tar.gz. Files matching secret patterns
# (*.key, *secret*, password material, private keys) are NEVER included,
# and key-like values in captured command output are redacted.
# A manifest.txt inside the bundle lists every file + collection time.
#
# Output contract: docs/14-MONITORING-AND-HEALTH.md ("bf-support-bundle ...
# secret ... ASLA pakete girmez").
#
# Install: install -m 0755 bf-support-bundle /usr/local/bin/bf-support-bundle
# Usage: bf-support-bundle [--out-dir DIR] [--help]
#
set -euo pipefail

OUT_DIR="/var/tmp"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: bf-support-bundle [--out-dir DIR] [--help]

Collect a secret-free support bundle (tar.gz with manifest.txt).

Options:
  --out-dir DIR   Directory for the tarball (default: /var/tmp)
  --help          Show this help and exit

Excluded (never packaged):
  *.key, *secret*, *password*, *passwd*, *private*,
  *id_rsa*, *id_ed25519*, *.pem, WireGuard private keys,
  RustDesk passwords, SSH private keys.

Manifest:
  manifest.txt inside the tarball lists each file, byte size,
  collection timestamp, and the exclusion patterns applied.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --out-dir) OUT_DIR="${2:?missing value for --out-dir}"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

HOST="$(hostname 2>/dev/null || echo unknown)"
STAMP="$(date '+%Y%m%d-%H%M%S' 2>/dev/null || echo unknown)"
WORK="$(mktemp -d)"
trap 'rm -rf "${WORK}"' EXIT

BUNDLE_NAME="blueforce-support-${HOST}-${STAMP}"
STAGE="${WORK}/${BUNDLE_NAME}"
mkdir -p "${STAGE}"

log() { echo "[bf-support-bundle] $*" >&2; }

# Exclude patterns: filename-level, applied to every copy step and tar.
EXCLUDE_PATTERNS=(
    '*.key' '*secret*' '*password*' '*passwd*' '*private*'
    '*id_rsa*' '*id_ed25519*' '*.pem' '*.p12' '*.pfx'
)
is_excluded() { # $1 = basename
    local base="$1" pat
    for pat in "${EXCLUDE_PATTERNS[@]}"; do
        # shellcheck disable=SC2053
        [[ "${base}" == ${pat} ]] && return 0
    done
    return 1
}

redact() { # stdin -> stdout: mask key-like values
    sed -E \
        -e 's/(private-key|public-key|preshared-key)([[:space:]]*[:=][[:space:]]*).*/\1\2<redacted>/I' \
        -e 's/(password|passwd|secret|token)([[:space:]]*[:=][[:space:]]*)[^[:space:]]+/\1\2<redacted>/I'
}

collect_cmd() { # $1 = outfile, $@ = command
    local out="$1"; shift
    { "$@" 2>&1 || echo "(command failed: $*)"; } | redact > "${out}" || true
}

log "collecting into ${STAGE}"

collect_cmd "${STAGE}/bf-status.txt" "${SCRIPT_DIR}/bf-status" || true
if [[ -x "${SCRIPT_DIR}/bf-diagnostics" ]]; then
    collect_cmd "${STAGE}/bf-diagnostics.txt" "${SCRIPT_DIR}/bf-diagnostics" || true
fi
collect_cmd "${STAGE}/system.txt" bash -c 'hostname; uptime; uname -a; systemctl get-default 2>/dev/null || echo "target: unknown"'
collect_cmd "${STAGE}/disk-df.txt" bash -c 'df -h / /var 2>/dev/null; echo ---; df -i / /var 2>/dev/null'
collect_cmd "${STAGE}/sockets.txt" bash -c 'ss -ltnp 2>/dev/null || ss -ltn 2>/dev/null || echo "ss not available"'
collect_cmd "${STAGE}/failed-units.txt" bash -c 'systemctl --failed --no-pager 2>/dev/null || echo "no failed units"'

if command -v journalctl >/dev/null 2>&1; then
    journalctl --since "24 hours ago" -p err --no-pager -o short 2>/dev/null | redact | tail -200 > "${STAGE}/journal-err-24h.txt" || echo "no journal access" > "${STAGE}/journal-err-24h.txt"
else
    echo "journalctl not available." > "${STAGE}/journal-err-24h.txt"
fi

if command -v wg >/dev/null 2>&1; then
    { wg show 2>/dev/null | redact || echo "no WireGuard interfaces"; echo "--- latest handshakes ---"; wg show all latest-handshakes 2>/dev/null || echo "no handshake data"; } > "${STAGE}/wireguard.txt" || true
else
    echo "wg tool not installed." > "${STAGE}/wireguard.txt"
fi

# Textfile collectors: copy *.prom only, never anything matching excludes.
mkdir -p "${STAGE}/textfile"
if [[ -d /var/lib/node_exporter/textfile ]]; then
    while IFS= read -r -d '' f; do
        base="$(basename "${f}")"
        if is_excluded "${base}"; then
            log "skipping excluded file: ${base}"
            continue
        fi
        cp "${f}" "${STAGE}/textfile/${base}" 2>/dev/null || true
    done < <(find /var/lib/node_exporter/textfile -maxdepth 1 -name '*.prom' -type f -print0 2>/dev/null || true)
    if [[ -z "$(ls -A "${STAGE}/textfile" 2>/dev/null)" ]]; then
        echo "textfile dir empty." > "${STAGE}/textfile/README.txt"
    fi
else
    echo "textfile dir missing." > "${STAGE}/textfile/README.txt"
fi

# Manifest: file list + sizes + timestamp + exclusion rules.
{
    echo "blueforce support bundle manifest"
    echo "host: ${HOST}"
    echo "collected_at: $(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)"
    echo "generator: bf-support-bundle"
    echo "excluded_patterns: ${EXCLUDE_PATTERNS[*]}"
    echo "note: secrets, private keys and passwords are never included; key-like values redacted."
    echo ""
    echo "files:"
    ( cd "${STAGE}" && find . -type f -printf '%p %s bytes\n' 2>/dev/null | sort ) || ( cd "${STAGE}" && find . -type f -exec wc -c {} + | sort )
} > "${STAGE}/manifest.txt"

mkdir -p "${OUT_DIR}"
TARBALL="${OUT_DIR}/${BUNDLE_NAME}.tar.gz"
tar --sort=name --mtime='UTC 2020-01-01' \
    --exclude='*.key' --exclude='*secret*' --exclude='*password*' \
    --exclude='*passwd*' --exclude='*private*' \
    --exclude='*id_rsa*' --exclude='*id_ed25519*' --exclude='*.pem' \
    -czf "${TARBALL}" -C "${WORK}" "${BUNDLE_NAME}"

log "wrote ${TARBALL}"
echo "${TARBALL}"
</file>

<file path="scripts/install/installer/modules/01-precheck.sh">
#!/usr/bin/env bash
# Pre-flight checks: root, Ubuntu 26.04, RAM/disk, internet.
# Idempotent: safe to re-run. Supports --check for read-only verification.
# Exit codes: 0 = OK, 3 = SKIP (optional step, nothing to do).
set -euo pipefail

MODULE="01-precheck"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
DEALER_ID="${DEALER_ID:-}"
BF_HOSTNAME="${BF_HOSTNAME:-}"
BF_DEVICE="${BF_DEVICE:-}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"

log() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [01-precheck] $msg" | tee -a "$LOG_FILE"
}

CHECK_MODE=0
if [[ "${1:-}" == "--check" ]]; then CHECK_MODE=1; fi
MIN_RAM_MB=2048
MIN_DISK_MB=20480

fail() { log "FAIL: $1"; echo "FAIL: $1" >&2; exit 1; }

run_checks() {
    [[ "$(id -u)" -eq 0 ]] || fail "must run as root"
    if [[ -f /etc/os-release ]]; then
        # shellcheck disable=SC1091
        . /etc/os-release
        [[ "${VERSION_ID:-}" == 26.04* ]] || fail "unsupported OS: ${NAME:-unknown} ${VERSION_ID:-unknown} (need Ubuntu 26.04)"
    else
        fail "/etc/os-release not found"
    fi
    local ram_mb disk_mb
    ram_mb=$(awk '/MemTotal/ {printf "%d", $2/1024}' /proc/meminfo)
    [[ "$ram_mb" -ge "$MIN_RAM_MB" ]] || fail "RAM too low: ${ram_mb}MB (need >= ${MIN_RAM_MB}MB)"
    disk_mb=$(df -m / --output=avail | tail -1 | tr -d ' ')
    [[ "$disk_mb" -ge "$MIN_DISK_MB" ]] || fail "disk too low: ${disk_mb}MB free on / (need >= ${MIN_DISK_MB}MB)"
    if ! getent hosts archive.ubuntu.com >/dev/null 2>&1 && ! ping -c1 -W5 1.1.1.1 >/dev/null 2>&1; then
        fail "no internet connectivity (DNS and ping both failed)"
    fi
    log "OK: precheck passed (Ubuntu ${VERSION_ID}, RAM ${ram_mb}MB, disk ${disk_mb}MB free)"
}

run_checks
</file>

<file path="scripts/install/installer/modules/02-system.sh">
#!/usr/bin/env bash
# Base APT sources, disable unattended-upgrades, set timezone.
# Idempotent: safe to re-run. Supports --check for read-only verification.
# Exit codes: 0 = OK, 3 = SKIP (optional step, nothing to do).
set -euo pipefail

MODULE="02-system"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
DEALER_ID="${DEALER_ID:-}"
BF_HOSTNAME="${BF_HOSTNAME:-}"
BF_DEVICE="${BF_DEVICE:-}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"

log() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [02-system] $msg" | tee -a "$LOG_FILE"
}

CHECK_MODE=0
if [[ "${1:-}" == "--check" ]]; then CHECK_MODE=1; fi
TIMEZONE="${TIMEZONE:-Europe/Istanbul}"
BASE_PKGS="curl wget ca-certificates gnupg lsb-release"

check_state() {
    local ok=1
    for p in $BASE_PKGS; do dpkg -s "$p" >/dev/null 2>&1 || { echo "missing package: $p"; ok=0; }; done
    grep -q '^APT::Periodic::Update-Package-Lists "0"' /etc/apt/apt.conf.d/20auto-upgrades 2>/dev/null || { echo "20auto-upgrades not locked"; ok=0; }
    for t in apt-daily.service apt-daily.timer apt-daily-upgrade.timer; do
        systemctl is-enabled "$t" 2>/dev/null | grep -q "masked" || { echo "timer not masked: $t"; ok=0; }
    done
    [[ "$(cat /etc/timezone 2>/dev/null || timedatectl show -p Timezone --value 2>/dev/null)" == "$TIMEZONE" ]] || { echo "timezone not $TIMEZONE"; ok=0; }
    return $((1 - ok))
}

if [[ "$CHECK_MODE" -eq 1 ]]; then
    if check_state; then log "OK(check): system baseline matches"; else log "FAIL(check): system baseline drift"; exit 1; fi
    exit 0
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update
# shellcheck disable=SC2086
apt-get install -y $BASE_PKGS

# Lock automatic updates OFF (fleet policy: no unapproved updates).
printf 'APT::Periodic::Update-Package-Lists "0";\nAPT::Periodic::Unattended-Upgrade "0";\n' > /tmp/20auto-upgrades.bf
mv /tmp/20auto-upgrades.bf /etc/apt/apt.conf.d/20auto-upgrades
for t in apt-daily.service apt-daily.timer apt-daily-upgrade.timer apt-daily-upgrade.service; do
    systemctl mask "$t" >/dev/null 2>&1 || true
done

if command -v timedatectl >/dev/null 2>&1; then
    timedatectl set-timezone "$TIMEZONE" || echo "$TIMEZONE" > /etc/timezone
else
    echo "$TIMEZONE" > /etc/timezone
fi
log "OK: base packages installed, unattended-upgrades disabled, timezone $TIMEZONE"
</file>

<file path="scripts/install/installer/modules/03-user.sh">
#!/usr/bin/env bash
# Blueforce maintenance user, restricted sudoers, mandatory administrator key.
set -euo pipefail
MODULE="03-user"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
CHECK_MODE=0
[[ "${1:-}" == "--check" ]] && CHECK_MODE=1
SUDOERS_FILE="/etc/sudoers.d/blueforce"
AUTHORIZED_KEYS="/home/blueforce/.ssh/authorized_keys"
BF_ADMIN_PUBLIC_KEY="${BF_ADMIN_PUBLIC_KEY:-}"
BF_ADMIN_PUBLIC_KEY_FILE="${BF_ADMIN_PUBLIC_KEY_FILE:-}"
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [03-user] $1" | tee -a "$LOG_FILE"; }
valid_key_file() { [[ -s "$AUTHORIZED_KEYS" ]] && ssh-keygen -l -f "$AUTHORIZED_KEYS" >/dev/null 2>&1; }
load_admin_key() {
    if [[ -n "$BF_ADMIN_PUBLIC_KEY" && -n "$BF_ADMIN_PUBLIC_KEY_FILE" ]]; then
        log "FAIL: set only one of BF_ADMIN_PUBLIC_KEY or BF_ADMIN_PUBLIC_KEY_FILE"; return 1
    elif [[ -n "$BF_ADMIN_PUBLIC_KEY" ]]; then
        printf '%s\n' "$BF_ADMIN_PUBLIC_KEY"
    elif [[ -n "$BF_ADMIN_PUBLIC_KEY_FILE" && -r "$BF_ADMIN_PUBLIC_KEY_FILE" ]]; then
        cat "$BF_ADMIN_PUBLIC_KEY_FILE"
    else
        log "FAIL: BF_ADMIN_PUBLIC_KEY or BF_ADMIN_PUBLIC_KEY_FILE is required before SSH hardening"; return 1
    fi
}
if [[ "$CHECK_MODE" -eq 1 ]]; then
    id blueforce >/dev/null 2>&1 || { log "FAIL(check): user blueforce missing"; exit 1; }
    [[ -f "$SUDOERS_FILE" ]] && visudo -cf "$SUDOERS_FILE" >/dev/null 2>&1 || { log "FAIL(check): sudoers invalid"; exit 1; }
    valid_key_file || { log "FAIL(check): authorized_keys is empty or invalid"; exit 1; }
    log "OK(check): user, sudoers, and a valid administrator key are present"; exit 0
fi
key_data="$(load_admin_key)" || exit 1
[[ -n "${key_data//[[:space:]]/}" ]] || { log "FAIL: administrator key is empty"; exit 1; }
tmp_key="$(mktemp)"; trap 'rm -f "$tmp_key"' EXIT
printf '%s\n' "$key_data" > "$tmp_key"
ssh-keygen -l -f "$tmp_key" >/dev/null 2>&1 || { log "FAIL: supplied administrator public key is invalid"; exit 1; }
if ! id blueforce >/dev/null 2>&1; then useradd -m -s /bin/bash blueforce; fi
passwd -l blueforce >/dev/null 2>&1 || true
install -d -m 700 -o blueforce -g blueforce /home/blueforce/.ssh
install -m 600 -o blueforce -g blueforce "$tmp_key" "$AUTHORIZED_KEYS"
valid_key_file || { log "FAIL: atomic authorized_keys install did not validate"; exit 1; }
cat > /tmp/blueforce.sudoers <<'EOF'
# Managed by blueforce-installer (03-user). Local edits will be overwritten.
blueforce ALL=(root) NOPASSWD: /usr/local/bin/bf-status, /usr/local/bin/bf-gui-on, /usr/local/bin/bf-gui-off, /bin/systemctl status *, /bin/systemctl is-active *, /bin/systemctl is-enabled *, /usr/bin/docker ps, /usr/bin/docker logs *
EOF
visudo -cf /tmp/blueforce.sudoers
install -m 440 /tmp/blueforce.sudoers "$SUDOERS_FILE"
log "OK: user blueforce has a validated administrator key and restricted sudoers"
</file>

<file path="scripts/install/installer/modules/04-hostname.sh">
#!/usr/bin/env bash
# Set hostname bf-<dealer-id> from validated dealer number.
# Idempotent: safe to re-run. Supports --check for read-only verification.
# Exit codes: 0 = OK, 3 = SKIP (optional step, nothing to do).
set -euo pipefail

MODULE="04-hostname"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
DEALER_ID="${DEALER_ID:-}"
BF_HOSTNAME="${BF_HOSTNAME:-}"
BF_DEVICE="${BF_DEVICE:-}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"

log() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [04-hostname] $msg" | tee -a "$LOG_FILE"
}

CHECK_MODE=0
if [[ "${1:-}" == "--check" ]]; then CHECK_MODE=1; fi
[[ -n "$DEALER_ID" ]] || { log "FAIL: DEALER_ID env is empty"; echo "FAIL: DEALER_ID env is empty" >&2; exit 1; }
[[ "$DEALER_ID" =~ ^[0-9]{8}$ ]] || { log "FAIL: bad DEALER_ID format: $DEALER_ID"; echo "FAIL: bad DEALER_ID" >&2; exit 1; }
TARGET="bf-${DEALER_ID}"

if [[ "$CHECK_MODE" -eq 1 ]]; then
    [[ "$(hostname)" == "$TARGET" ]] || { log "FAIL(check): hostname is $(hostname), want $TARGET"; exit 1; }
    log "OK(check): hostname is $TARGET"
    exit 0
fi

if [[ "$(hostname)" == "$TARGET" ]]; then
    log "hostname already $TARGET, keeping"
else
    hostnamectl set-hostname "$TARGET"
    if grep -q "127.0.1.1" /etc/hosts; then
        sed -i "s/^127.0.1.1.*/127.0.1.1\t$TARGET/" /etc/hosts
    else
        echo -e "127.0.1.1\t$TARGET" >> /etc/hosts
    fi
    log "hostname set to $TARGET"
fi
mkdir -p "$STATE_DIR"
echo "$DEALER_ID" > "$STATE_DIR/dealer-id"
echo "bf-${DEALER_ID}" > "$STATE_DIR/hostname"
echo "BF-${DEALER_ID}" > "$STATE_DIR/device-id"
log "OK: identity files written (BF-${DEALER_ID} / bf-${DEALER_ID})"
</file>

<file path="scripts/install/installer/modules/05-network.sh">
#!/usr/bin/env bash
# Wait for NetworkManager, verify DNS and connectivity.
# Idempotent: safe to re-run. Supports --check for read-only verification.
# Exit codes: 0 = OK, 3 = SKIP (optional step, nothing to do).
set -euo pipefail

MODULE="05-network"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
DEALER_ID="${DEALER_ID:-}"
BF_HOSTNAME="${BF_HOSTNAME:-}"
BF_DEVICE="${BF_DEVICE:-}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"

log() {
    local msg="$1"
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [05-network] $msg" | tee -a "$LOG_FILE"
}

CHECK_MODE=0
if [[ "${1:-}" == "--check" ]]; then CHECK_MODE=1; fi
WAIT_SECS="${NM_WAIT_SECS:-90}"

if [[ "$CHECK_MODE" -eq 1 ]]; then
    getent hosts archive.ubuntu.com >/dev/null 2>&1 || { log "FAIL(check): DNS resolution broken"; exit 1; }
    log "OK(check): DNS resolves"
    exit 0
fi

elapsed=0
while [[ "$elapsed" -lt "$WAIT_SECS" ]]; do
    if systemctl is-active --quiet NetworkManager 2>/dev/null || systemctl is-active --quiet systemd-networkd 2>/dev/null; then
        break
    fi
    sleep 5; elapsed=$((elapsed + 5))
done
systemctl is-active --quiet NetworkManager 2>/dev/null || systemctl is-active --quiet systemd-networkd 2>/dev/null     || { log "FAIL: no network manager active after ${WAIT_SECS}s"; exit 1; }

getent hosts archive.ubuntu.com >/dev/null 2>&1 || { log "FAIL: DNS resolution failed"; exit 1; }
[[ -f /etc/resolv.conf ]] || { log "FAIL: /etc/resolv.conf missing"; exit 1; }
log "OK: network manager active, DNS resolves"
</file>

<file path="scripts/install/installer/modules/06-wireguard.sh">
#!/usr/bin/env bash
# WireGuard per-device configuration; refuse placeholders or shared defaults.
# Idempotent: safe to re-run. Supports --check for read-only verification.
set -euo pipefail

MODULE="06-wireguard"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
DEALER_ID="${DEALER_ID:-}"
BF_HOSTNAME="${BF_HOSTNAME:-}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"
CHECK_MODE=0
[[ "${1:-}" == "--check" ]] && CHECK_MODE=1
WG_DIR="/etc/wireguard"
WG_CONF="$WG_DIR/wg0.conf"
WG_ADDRESS="${WG_ADDRESS:-}"
WG_ENDPOINT="${WG_ENDPOINT:-}"
WG_PEER_PUBKEY="${WG_PEER_PUBKEY:-}"
REQUIRE_WIREGUARD="${REQUIRE_WIREGUARD:-true}"
BF_WG_HANDSHAKE_MAX_AGE="${BF_WG_HANDSHAKE_MAX_AGE:-180}"

log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [06-wireguard] $1" | tee -a "$LOG_FILE"; }
valid_address() {
    local address="$1" ip prefix octet
    [[ "$address" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]] && [[ "$address" != "10.88.0.0/24" ]] || return 1
    ip="${address%/*}"; prefix="${address#*/}"
    IFS=. read -r -a octets <<< "$ip"
    for octet in "${octets[@]}"; do ((10#$octet <= 255)) || return 1; done
    ((10#$prefix <= 32))
}
valid_endpoint() {
    local host port
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*:[1-9][0-9]{0,4}$ ]] && [[ "$1" != "vpn.example.com:51820" ]] || return 1
    host="${1%:*}"; port="${1##*:}"
    [[ -n "$host" ]] && ((10#$port <= 65535))
}
valid_pubkey() { [[ "$1" =~ ^[A-Za-z0-9+/]{43}=$ ]] && [[ "$1" != "REPLACE_WITH_SERVER_PUBLIC_KEY" ]]; }
valid_handshake_age() { [[ "$BF_WG_HANDSHAKE_MAX_AGE" =~ ^[0-9]+$ ]] && ((10#$BF_WG_HANDSHAKE_MAX_AGE > 0)); }
config_is_complete() {
    [[ -f "$WG_CONF" ]] &&
    ! grep -qE '10\.88\.0\.0/24|vpn\.example\.com:51820|REPLACE_WITH_SERVER_PUBLIC_KEY' "$WG_CONF" &&
    grep -qE '^Address = ([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$' "$WG_CONF" &&
    grep -qE '^Endpoint = [A-Za-z0-9][A-Za-z0-9.-]*:[1-9][0-9]{0,4}$' "$WG_CONF" &&
    grep -qE '^PublicKey = [A-Za-z0-9+/]{43}=$' "$WG_CONF"
}
handshake_is_fresh() {
    local now
    valid_handshake_age || return 1
    now="$(date +%s)"
    wg show wg0 latest-handshakes 2>/dev/null | awk -v now="$now" -v max_age="$BF_WG_HANDSHAKE_MAX_AGE" '$2 > 0 && now >= $2 && now - $2 <= max_age { found=1 } END { exit(found ? 0 : 1) }'
}

if [[ "$CHECK_MODE" -eq 1 ]]; then
    [[ "$REQUIRE_WIREGUARD" == "true" || "$REQUIRE_WIREGUARD" == "false" ]] || { log "FAIL(check): REQUIRE_WIREGUARD must be true or false"; exit 1; }
    [[ -f "$WG_DIR/privatekey" && -f "$WG_DIR/publickey" ]] || { log "FAIL(check): wireguard keys missing"; exit 1; }
    config_is_complete || { log "FAIL(check): wg0.conf is missing or contains incomplete/placeholder peer data"; exit 1; }
    systemctl is-enabled --quiet wg-quick@wg0 || { log "FAIL(check): wg-quick@wg0 not enabled"; exit 1; }
    systemctl is-active --quiet wg-quick@wg0 || { log "FAIL(check): wg-quick@wg0 not active"; exit 1; }
    wg show interfaces | tr ' ' '\n' | grep -qx wg0 || { log "FAIL(check): wg0 interface missing"; exit 1; }
    if [[ "$REQUIRE_WIREGUARD" == "true" ]]; then
        handshake_is_fresh || { log "FAIL(check): no WireGuard peer handshake within ${BF_WG_HANDSHAKE_MAX_AGE}s"; exit 1; }
    fi
    log "OK(check): wireguard config is complete, wg0 is active, and required handshake is fresh"
    exit 0
fi

valid_address "$WG_ADDRESS" || { log "FAIL: WG_ADDRESS must be a unique device CIDR, not a default or placeholder"; exit 1; }
valid_endpoint "$WG_ENDPOINT" || { log "FAIL: WG_ENDPOINT must be a non-placeholder host:port"; exit 1; }
valid_pubkey "$WG_PEER_PUBKEY" || { log "FAIL: WG_PEER_PUBKEY must be a valid non-placeholder WireGuard public key"; exit 1; }
[[ "$REQUIRE_WIREGUARD" == "true" || "$REQUIRE_WIREGUARD" == "false" ]] || { log "FAIL: REQUIRE_WIREGUARD must be true or false"; exit 1; }
valid_handshake_age || { log "FAIL: BF_WG_HANDSHAKE_MAX_AGE must be a positive number of seconds"; exit 1; }
command -v wg >/dev/null 2>&1 || { export DEBIAN_FRONTEND=noninteractive; apt-get update && apt-get install -y wireguard; }
install -d -m 700 "$WG_DIR"
if [[ ! -f "$WG_DIR/privatekey" ]]; then
    umask 077
    wg genkey | tee "$WG_DIR/privatekey" | wg pubkey > "$WG_DIR/publickey"
    chmod 600 "$WG_DIR/privatekey" "$WG_DIR/publickey"
    log "wireguard keypair generated"
fi
PRIVKEY="$(<"$WG_DIR/privatekey")"
PEER_NAME="${BF_HOSTNAME:-bf-${DEALER_ID:-unknown}}"
tmp_conf="$(mktemp "$WG_DIR/wg0.conf.XXXXXX")"
cat > "$tmp_conf" <<EOF
# Managed by blueforce-installer (06-wireguard). Per-device peer data only.
[Interface]
PrivateKey = ${PRIVKEY}
Address = ${WG_ADDRESS}
DNS = 1.1.1.1

[Peer]
# peer name: ${PEER_NAME}
PublicKey = ${WG_PEER_PUBKEY}
Endpoint = ${WG_ENDPOINT}
AllowedIPs = 10.0.0.0/8
PersistentKeepalive = 25
EOF
chmod 600 "$tmp_conf"
mv "$tmp_conf" "$WG_CONF"
systemctl enable wg-quick@wg0
systemctl restart wg-quick@wg0
systemctl is-active --quiet wg-quick@wg0 || { log "FAIL: wg-quick@wg0 did not start"; exit 1; }
wg show interfaces | tr ' ' '\n' | grep -qx wg0 || { log "FAIL: wg0 interface was not created"; exit 1; }
if [[ "$REQUIRE_WIREGUARD" == "true" ]]; then
    handshake_is_fresh || { log "FAIL: WireGuard peer handshake did not complete within ${BF_WG_HANDSHAKE_MAX_AGE}s"; exit 1; }
fi
log "OK: wireguard configured with supplied per-device peer data"
</file>

<file path="scripts/install/installer/modules/07-ssh.sh">
#!/usr/bin/env bash
# Harden sshd only after a validated Blueforce administrator key is installed.
set -euo pipefail
MODULE="07-ssh"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
CHECK_MODE=0
[[ "${1:-}" == "--check" ]] && CHECK_MODE=1
DROPIN="/etc/ssh/sshd_config.d/99-blueforce.conf"
AUTHORIZED_KEYS="/home/blueforce/.ssh/authorized_keys"
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [07-ssh] $1" | tee -a "$LOG_FILE"; }
key_ready() { [[ -s "$AUTHORIZED_KEYS" ]] && ssh-keygen -l -f "$AUTHORIZED_KEYS" >/dev/null 2>&1; }
read -r -d '' WANT <<'EOF' || true
# Managed by blueforce-installer (07-ssh). Local edits will be overwritten.
PermitRootLogin no
PasswordAuthentication no
PubkeyAuthentication yes
ChallengeResponseAuthentication no
UsePAM yes
X11Forwarding no
ClientAliveInterval 300
ClientAliveCountMax 2
MaxAuthTries 3
AllowUsers blueforce
EOF
if [[ "$CHECK_MODE" -eq 1 ]]; then
    [[ -f "$DROPIN" ]] || { log "FAIL(check): sshd drop-in missing"; exit 1; }
    key_ready || { log "FAIL(check): no valid non-empty blueforce authorized_keys"; exit 1; }
    grep -qx 'AllowUsers blueforce' "$DROPIN" || { log "FAIL(check): AllowUsers policy is incorrect"; exit 1; }
    sshd -t 2>/dev/null || { log "FAIL(check): sshd config test failed"; exit 1; }
    log "OK(check): hardened SSH permits only blueforce with a valid key"; exit 0
fi
export DEBIAN_FRONTEND=noninteractive
command -v sshd >/dev/null 2>&1 || apt-get install -y openssh-server
key_ready || { log "FAIL: valid non-empty /home/blueforce/.ssh/authorized_keys is required before SSH hardening"; exit 1; }
printf '%s\n' "$WANT" > /tmp/99-blueforce.conf.bf
install -m 644 /tmp/99-blueforce.conf.bf "$DROPIN"
sshd -t || { log "FAIL: sshd -t rejected the new config"; exit 1; }
if systemctl list-unit-files | grep -q '^sshd\.service'; then SVC=sshd; else SVC=ssh; fi
systemctl enable "$SVC" >/dev/null 2>&1 || true
systemctl reload-or-restart "$SVC"
log "OK: hardened SSH installed after valid key verification; AllowUsers=blueforce"
</file>

