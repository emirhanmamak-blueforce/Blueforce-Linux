<file path="ansible/playbooks/bf-collect-logs.yml">
---
# Collect timestamped journald logs and a support snapshot from one approved wave.
- name: Collect support logs
  hosts: "{{ operation_wave | default('invalid-wave', true) }}"
  gather_facts: false
  become: true
  vars:
    approved_operation_waves: [lab, pilot_1, pilot_2, wave_1, wave_2, production]
    production_override: false
    collect_logs_dir: "{{ support_bundle_dir | default('/var/lib/blueforce/support-bundles') }}"
    collect_log_lines: "{{ log_lines | default(500) }}"
    fetch_logs: false
  pre_tasks:
    - name: Require confirmed approved operation wave scope
      ansible.builtin.assert:
        that:
          - operation_wave in approved_operation_waves
          - operation_confirmed | bool
          - operation_wave in groups
          - ansible_play_hosts_all | length > 0
          - ansible_play_hosts_all | difference(groups[operation_wave]) | length == 0
        fail_msg: "Set operation_wave to one inventory wave and operation_confirmed=true; full-fleet scope is refused."
      run_once: true

    - name: Require a safe support bundle directory
      ansible.builtin.assert:
        that:
          - collect_logs_dir is match('^/var/lib/blueforce/support-bundles(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*\Z')
        fail_msg: "support_bundle_dir must be /var/lib/blueforce/support-bundles or an approved alphanumeric subpath; shell metacharacters are refused."
      run_once: true

    - name: Require separate production override
      ansible.builtin.assert:
        that:
          - operation_wave != 'production' or production_override | bool
        fail_msg: "Production operation requires production_override=true in addition to operation_confirmed=true."
      run_once: true
  tasks:
    - name: Generate unique bundle timestamp
      ansible.builtin.command: date -u +%Y%m%dT%H%M%SZ
      register: bundle_timestamp
      changed_when: false

    - name: Ensure bundle directory exists
      ansible.builtin.file:
        path: "{{ collect_logs_dir }}"
        state: directory
        owner: root
        group: root
        mode: "0750"

    - name: Export recent journal to timestamped bundle
      ansible.builtin.shell: >-
        journalctl -n {{ collect_log_lines | int }} --no-pager >
        {{ (collect_logs_dir ~ '/journal-' ~ inventory_hostname ~ '-' ~ bundle_timestamp.stdout ~ '.log') | quote }}
      changed_when: true

    - name: Record timestamped kernel and disk snapshot
      ansible.builtin.shell: >-
        { uname -a; printf '%s\\n' '---'; df -h; printf '%s\\n' '---'; uptime; } >
        {{ (collect_logs_dir ~ '/snapshot-' ~ inventory_hostname ~ '-' ~ bundle_timestamp.stdout ~ '.txt') | quote }}
      changed_when: true

    - name: Fetch timestamped journal bundle to controller
      ansible.builtin.fetch:
        src: "{{ collect_logs_dir }}/journal-{{ inventory_hostname }}-{{ bundle_timestamp.stdout }}.log"
        dest: "fetched-logs/{{ inventory_hostname }}/"
        flat: true
      when: fetch_logs | bool
</file>

<file path="ansible/playbooks/bf-deploy-update.yml">
---
# Approved package update with mandatory wave scope and per-batch health gates.
# Example: ansible-playbook -i inventory/hosts.yml playbooks/bf-deploy-update.yml -e release_wave=lab -e wave_gate_confirmed=true -e update_packages='["package=version"]'
- name: Deploy approved package update
  hosts: "{{ release_wave | default('invalid-wave', true) }}"
  gather_facts: false
  become: true
  serial: 5
  max_fail_percentage: 0
  any_errors_fatal: true
  vars:
    release_wave: ""
    wave_gate_confirmed: false
    production_override: false
    halt_on_fail: true
    update_packages: []
    update_cache_time: 3600
    approved_waves: [lab, pilot_1, pilot_2, wave_1, wave_2, production]
  pre_tasks:
    - name: Require a valid rollout wave
      ansible.builtin.assert:
        that:
          - release_wave in approved_waves
          - release_wave in groups
          - groups[release_wave] | length > 0
        fail_msg: "release_wave must name a non-empty approved inventory group; refusing an ungated rollout."
      run_once: true

    - name: Require exact or subset host selection for release wave
      ansible.builtin.assert:
        that:
          - ansible_play_hosts_all | length > 0
          - ansible_play_hosts_all | difference(groups[release_wave]) | length == 0
        fail_msg: "Selected hosts must equal or be a subset of groups[release_wave]; broader fleet scope is refused."
      run_once: true

    - name: Require central wave-gate confirmation
      ansible.builtin.assert:
        that:
          - wave_gate_confirmed | bool
        fail_msg: "Set wave_gate_confirmed=true only after the prior wave health gate and central approval pass."
      run_once: true

    - name: Require separate production override
      ansible.builtin.assert:
        that:
          - release_wave != 'production' or production_override | bool
        fail_msg: "Production rollout requires production_override=true in addition to wave_gate_confirmed=true."
      run_once: true

    - name: Require halt-on-failure protection
      ansible.builtin.assert:
        that:
          - halt_on_fail | bool
        fail_msg: "halt_on_fail must remain true for every rollout."
      run_once: true

    - name: Require pinned package versions
      ansible.builtin.assert:
        that:
          - update_packages | length > 0
          - update_packages | select('match', '^[A-Za-z0-9][A-Za-z0-9+_.:-]*=.+$') | list | length == update_packages | length
        fail_msg: "update_packages must be a non-empty list of exact package=version pins."
      run_once: true
  tasks:
    - name: Update apt cache
      ansible.builtin.apt:
        update_cache: true
        cache_valid_time: "{{ update_cache_time }}"

    - name: Install approved pinned package versions
      ansible.builtin.apt:
        name: "{{ update_packages }}"
        state: present
        allow_downgrade: true
  post_tasks:
    - name: Run mandatory post-batch health gate
      ansible.builtin.command: /usr/local/bin/bf-status
      register: update_health
      changed_when: false
      failed_when: update_health.rc != 0

    - name: Report passed post-batch health gate
      ansible.builtin.debug:
        msg: "Update batch health gate passed for {{ ansible_play_batch }}"
      run_once: true
</file>

<file path="ansible/playbooks/bf-disk-check.yml">
---
# Check disk usage (read-only) and warn above threshold.
# Run: ansible-playbook -i inventory/hosts.yml playbooks/bf-disk-check.yml --limit lab
# Threshold overridable: -e disk_warn_pct=80.
# No Semaphore Pro feature is used.
- name: Check disk usage
  hosts: blueforce
  gather_facts: false
  vars:
    disk_warning_percent: "{{ disk_warn_pct | default(80) }}"
  tasks:
    - name: Get disk usage
      ansible.builtin.command: df -h --output=source,pcent,target
      register: df_out
      changed_when: false

    - name: Show disk usage
      ansible.builtin.debug:
        msg: "{{ inventory_hostname }}:\n{{ df_out.stdout }}"

    - name: Get root filesystem usage percentage
      ansible.builtin.shell: "df --output=pcent / | tail -n 1 | tr -dc '0-9'"
      register: root_pct
      changed_when: false

    - name: Flag hosts above threshold
      ansible.builtin.debug:
        msg: "WARNING {{ inventory_hostname }} root disk {{ root_pct.stdout }}% exceeds {{ disk_warning_percent }}%"
      when: root_pct.stdout | int >= (disk_warning_percent | int)
</file>

