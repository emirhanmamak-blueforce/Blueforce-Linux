<file path="scripts/install/installer/modules/18-final-check.sh">
#!/usr/bin/env bash
# Gate all installer modules; READY is written only when every required channel passes.
set -euo pipefail
MODULE="18-final-check"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
DEALER_ID="${DEALER_ID:-}"
BF_HOSTNAME="${BF_HOSTNAME:-}"
BF_DEVICE="${BF_DEVICE:-}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"
CHECK_MODE=0
[[ "${1:-}" == "--check" ]] && CHECK_MODE=1
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GATES=(01-precheck 02-system 03-user 04-hostname 05-network 06-wireguard 07-ssh 08-rdp 09-rustdesk 10-docker 11-meg 12-monitoring 13-firewall 14-update-policy 15-logrotate 16-gui 17-healthcheck)
READY_FILE="$STATE_DIR/READY"
log() { echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [18-final-check] $1" | tee -a "$LOG_FILE"; }
self_gate() { [[ -n "$DEALER_ID" && "$DEALER_ID" =~ ^[0-9]{8}$ ]] && [[ "$(hostname)" == "bf-${DEALER_ID}" ]]; }
run_gates() {
  local fails=0 skipped=0 out rc g
  for g in "${GATES[@]}"; do
    set +e; out=$(DEALER_ID="$DEALER_ID" BF_HOSTNAME="$BF_HOSTNAME" BF_DEVICE="$BF_DEVICE" STATE_DIR="$STATE_DIR" REQUIRE_WIREGUARD="${REQUIRE_WIREGUARD:-true}" BF_WG_HANDSHAKE_MAX_AGE="${BF_WG_HANDSHAKE_MAX_AGE:-180}" LOG_FILE=/dev/null bash "$SCRIPT_DIR/$g.sh" --check 2>&1); rc=$?; set -e
    case "$rc" in 0) echo "GATE $g: PASS";; 3) echo "GATE $g: SKIP (not READY)"; skipped=$((skipped+1)); fails=$((fails+1));; *) echo "GATE $g: FAIL"; echo "$out" | tail -3; fails=$((fails+1));; esac
  done
  if self_gate; then echo 'GATE 18-final-check: PASS'; else echo 'GATE 18-final-check: FAIL'; fails=$((fails+1)); fi
  echo "---"; echo "gates: 18 total, $fails failed, $skipped skipped"; return "$fails"
}
if [[ "$CHECK_MODE" -eq 1 ]]; then run_gates; exit $?; fi
if run_gates; then
  install -d -m 700 "$STATE_DIR"
  printf 'READY dealer=BF-%s host=bf-%s date=%s\n' "$DEALER_ID" "$DEALER_ID" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$READY_FILE"
  log "OK: ALL REQUIRED GATES PASSED — device READY (BF-${DEALER_ID})"
else
  log "FAIL: final-check gates failed — device NOT READY"; exit 1
fi
</file>

<file path="scripts/install/blueforce-install.sh">
#!/usr/bin/env bash
# Blueforce one-click installer — single entry point for field setup.
set -euo pipefail
INSTALLER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODULES_DIR="$INSTALLER_DIR/installer/modules"
LOG_FILE="${LOG_FILE:-/var/log/blueforce-install.log}"
STATE_DIR="${STATE_DIR:-/var/lib/blueforce}"
STATE_FILE="$STATE_DIR/install-state"
MODULES=(01-precheck 02-system 03-user 04-hostname 05-network 06-wireguard 07-ssh 08-rdp 09-rustdesk 10-docker 11-meg 12-monitoring 13-firewall 14-update-policy 15-logrotate 16-gui 17-healthcheck 18-final-check)
DEALER_ID="" FROM="" ONLY="" CHECK_MODE=0 RESUME=0 ASSUME_YES=0
usage() { cat <<'EOF'
Usage: sudo ./blueforce-install.sh --dealer-id <8 digits> [--from NN] [--only NAME] [--check] [--resume] [--yes]
--check is read-only: it creates no logs, state, or directories.
EOF
}
while [[ $# -gt 0 ]]; do case "$1" in --dealer-id) DEALER_ID="${2:-}"; shift 2;; --from) FROM="${2:-}"; shift 2;; --only) ONLY="${2:-}"; shift 2;; --check) CHECK_MODE=1; shift;; --resume) RESUME=1; shift;; --yes|-y) ASSUME_YES=1; shift;; --help|-h) usage; exit 0;; *) echo "Unknown argument: $1" >&2; usage >&2; exit 2;; esac; done
[[ -n "$DEALER_ID" ]] || { echo "Missing --dealer-id (8 digits)" >&2; exit 2; }
[[ "$DEALER_ID" =~ ^[0-9]{8}$ ]] || { echo "Invalid dealer id '$DEALER_ID': must match ^[0-9]{8}$" >&2; exit 2; }
log() { if [[ "$CHECK_MODE" -eq 1 ]]; then printf '[installer check] %s\n' "$1" >&2; else mkdir -p "$(dirname "$LOG_FILE")" "$STATE_DIR"; echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [installer] $1" | tee -a "$LOG_FILE"; fi; }
record_state() { mkdir -p "$STATE_DIR"; local tmp="$STATE_FILE.tmp"; grep -v "^$1=" "$STATE_FILE" 2>/dev/null > "$tmp" || true; echo "$1=$2" >> "$tmp"; mv "$tmp" "$STATE_FILE"; }
state_of() { grep "^$1=" "$STATE_FILE" 2>/dev/null | cut -d= -f2 || true; }
export DEALER_ID BF_HOSTNAME="bf-${DEALER_ID}" BF_DEVICE="BF-${DEALER_ID}" STATE_DIR
if [[ "$CHECK_MODE" -eq 0 && "$ASSUME_YES" -eq 0 ]]; then read -r -p "Proceed with installation as $BF_DEVICE? [y/N] " answer; [[ "$answer" =~ ^[Yy]$ ]] || { echo Aborted.; exit 2; }; fi
RUN=(); for m in "${MODULES[@]}"; do
  if [[ -n "$ONLY" ]]; then [[ "$m" == "$ONLY" || "$m" == "$ONLY"* ]] && RUN+=("$m"); continue; fi
  [[ -n "$FROM" && "${m%%-*}" < "$FROM" ]] && continue
  if [[ "$CHECK_MODE" -eq 0 && "$RESUME" -eq 1 && "$(state_of "$m")" == OK ]]; then log "SKIP $m (already OK)"; continue; fi
  RUN+=("$m")
done
[[ ${#RUN[@]} -gt 0 ]] || { echo "No modules selected." >&2; exit 2; }
log "=== install start dealer=$BF_DEVICE mode=$([[ "$CHECK_MODE" -eq 1 ]] && echo check || echo apply) modules=${RUN[*]} ==="
failures=0
for m in "${RUN[@]}"; do
 script="$MODULES_DIR/$m.sh"; if [[ ! -x "$script" ]]; then log "FAIL $m (script missing)"; [[ "$CHECK_MODE" -eq 0 ]] && record_state "$m" FAIL; failures=$((failures+1)); break; fi
 args=(); [[ "$CHECK_MODE" -eq 1 ]] && args+=(--check)
 set +e; if [[ "$CHECK_MODE" -eq 1 ]]; then LOG_FILE=/dev/null bash "$script" "${args[@]}"; else LOG_FILE="$LOG_FILE" bash "$script"; fi; rc=$?; set -e
 case "$rc" in 0) log "OK $m"; [[ "$CHECK_MODE" -eq 0 ]] && record_state "$m" OK;; 3) log "SKIP $m"; [[ "$CHECK_MODE" -eq 0 ]] && record_state "$m" SKIP;; *) log "FAIL $m (exit $rc)"; [[ "$CHECK_MODE" -eq 0 ]] && record_state "$m" FAIL; failures=$((failures+1)); [[ "$CHECK_MODE" -eq 0 ]] && exit 1;; esac
done
[[ "$CHECK_MODE" -eq 1 && "$failures" -gt 0 ]] && exit 1
log "=== install done dealer=$BF_DEVICE failures=$failures ==="
</file>

<file path="scripts/install/README.md">
# Blueforce installer (`scripts/install/`)

Single entry point: `sudo ./blueforce-install.sh --dealer-id <8 digits>`.

- Orchestrator: `blueforce-install.sh` (dealer-id gate `^[0-9]{8}$`,
  hostname `bf-<no>` + device `BF-<no>`, ordered module runs, `--resume`,
  results to `/var/log/blueforce-install.log` + `/var/lib/blueforce/install-state`).
- Modules: `installer/modules/01-*.sh` … `18-*.sh`. Every module is idempotent
  and supports `--check` (read-only audit). Exit `0` = OK, `3` = SKIP.
- Required remote-channel preconditions: set per-device `WG_ADDRESS`, `WG_ENDPOINT`,
  and `WG_PEER_PUBKEY`; WireGuard readiness requires a peer handshake no older than
  `BF_WG_HANDSHAKE_MAX_AGE` seconds (default `180`) unless `REQUIRE_WIREGUARD=false`.
  Set `RUSTDESK_SERVER` to a real self-hosted endpoint and provide the pinned local
  `RUSTDESK_DEB`; placeholders are rejected.
- Docker published ports default to deny. Add only reviewed `tcp PORT` or `udp PORT`
  entries to `/etc/blueforce/docker-published-port-allowlist.conf`; the enabled
  `blueforce-docker-firewall.service` reapplies that policy after Docker starts.
- Exit codes: `0` READY · `1` module failure · `2` argument/format error.

Module map: 01-precheck · 02-system · 03-user · 04-hostname · 05-network ·
06-wireguard · 07-ssh · 08-rdp · 09-rustdesk · 10-docker · 11-meg ·
12-monitoring · 13-firewall · 14-update-policy · 15-logrotate · 16-gui ·
17-healthcheck · 18-final-check.

NOTE on AnyDesk: there is deliberately no AnyDesk module. Remote access is
covered by SSH-over-WireGuard, xRDP and RustDesk. AnyDesk stays a manual,
per-device exception outside this installer.
</file>

<file path="scripts/maintenance/bf-gui-off">
#!/usr/bin/env bash
#
# bf-gui-off - Switch the field terminal back to console (multi-user) mode.
#
# Stops graphical services (xRDP + display manager) and isolates
# multi-user.target. Idempotent: already-console systems are left untouched.
#
# Install: install -m 0755 bf-gui-off /usr/local/bin/bf-gui-off
# Usage: sudo bf-gui-off
#
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bf-gui-off [--help]

Stop the graphical layer and return the device to console mode.

Options:
  --help   Show this help and exit

Behavior:
  - Stops xrdp, xrdp-sesman and the display manager (gdm3/gdm/...)
  - Disables them so they do not restart on boot
  - Runs 'systemctl isolate multi-user.target'
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h) usage; exit 0 ;;
        *) echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: bf-gui-off must run as root (use sudo)." >&2
    exit 1
fi

log() { echo "[bf-gui-off] $*"; }

UNITS=(xrdp xrdp-sesman gdm3 gdm sddm lightdm)

for unit in "${UNITS[@]}"; do
    if systemctl list-unit-files --type=service 2>/dev/null | grep -q "^${unit}"; then
        if systemctl is-active --quiet "${unit}"; then
            log "Stopping ${unit} ..."
            systemctl stop "${unit}" || log "WARNING: failed to stop ${unit}."
        else
            log "${unit} already stopped."
        fi
        systemctl disable "${unit}" >/dev/null 2>&1 || true
    fi
done

log "Isolating multi-user.target ..."
systemctl isolate multi-user.target

log "GUI is OFF (console mode)."
</file>

<file path="scripts/maintenance/bf-gui-on">
#!/usr/bin/env bash
#
# bf-gui-on - Switch the field terminal to graphical mode and prepare RDP.
#
# Enables and starts the display manager plus xRDP services, isolates the
# graphical target, then waits until RDP is ready to accept sessions.
# Idempotent: already-graphical systems are left untouched.
#
# Install: install -m 0755 bf-gui-on /usr/local/bin/bf-gui-on
# Usage: sudo bf-gui-on [--timeout SECS]
#
set -euo pipefail

TIMEOUT=60
DISPLAY_MANAGER=""

usage() {
    cat <<'EOF'
Usage: bf-gui-on [--timeout SECS] [--help]

Switch the device to graphical mode and wait until RDP is ready.

Options:
  --timeout SECS   Seconds to wait for RDP port 3389 (default: 60)
  --help           Show this help and exit

Behavior:
  - Enables and starts the display manager (gdm3/gdm) + xrdp + xrdp-sesman
  - Runs 'systemctl isolate graphical.target'
  - Waits until TCP/3389 accepts connections (RDP ready standby)
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --timeout) TIMEOUT="${2:?missing value for --timeout}"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) echo "ERROR: unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
done

if [[ "$(id -u)" -ne 0 ]]; then
    echo "ERROR: bf-gui-on must run as root (use sudo)." >&2
    exit 1
fi

log() { echo "[bf-gui-on] $*"; }

# Detect installed display manager unit (LAB validates exact names on 26.04.1).
detect_dm() {
    local candidate
    for candidate in gdm3.service gdm.service sddm.service lightdm.service; do
        if systemctl list-unit-files --type=service 2>/dev/null | grep -q "^${candidate}"; then
            echo "${candidate%.service}"
            return 0
        fi
    done
    return 1
}

if DISPLAY_MANAGER="$(detect_dm)"; then
    log "Display manager detected: ${DISPLAY_MANAGER}"
else
    log "WARNING: no display manager unit found; proceeding with xrdp only."
fi

UNITS=()
[[ -n "${DISPLAY_MANAGER}" ]] && UNITS+=("${DISPLAY_MANAGER}")
UNITS+=(xrdp xrdp-sesman)

# Enable units that exist so GUI survives reboot while switched on.
for unit in "${UNITS[@]}"; do
    if systemctl list-unit-files --type=service 2>/dev/null | grep -q "^${unit}"; then
        systemctl enable "${unit}" >/dev/null 2>&1 || true
    else
        log "WARNING: unit ${unit} not installed; skipping."
    fi
done

CURRENT="$(systemctl get-default 2>/dev/null || echo unknown)"
log "Current default target: ${CURRENT}"

log "Isolating graphical.target ..."
systemctl isolate graphical.target

for unit in "${UNITS[@]}"; do
    if systemctl list-unit-files --type=service 2>/dev/null | grep -q "^${unit}"; then
        if ! systemctl is-active --quiet "${unit}"; then
            log "Starting ${unit} ..."
            systemctl start "${unit}" || log "WARNING: failed to start ${unit}."
        else
            log "${unit} already active."
        fi
    fi
done

# Wait for RDP standby on TCP/3389.
log "Waiting for RDP (TCP/3389) up to ${TIMEOUT}s ..."
elapsed=0
while [[ "${elapsed}" -lt "${TIMEOUT}" ]]; do
    if (exec 3<>/dev/tcp/127.0.0.1/3389) >/dev/null 2>&1; then
        exec 3>&- 2>/dev/null || true
        log "RDP is ready (graphical ON)."
        exit 0
    fi
    sleep 2
    elapsed=$((elapsed + 2))
done

echo "ERROR: RDP port 3389 did not open within ${TIMEOUT}s." >&2
echo "HINT: check 'systemctl status xrdp xrdp-sesman' and journal." >&2
exit 1
</file>

